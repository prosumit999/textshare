---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileDrawer from '../components/MobileDrawer.astro';
import BackToTop from '../components/BackToTop.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import PricingModal from '../components/PricingModal.astro';

interface Props {
  title?: string;
  description?: string;
  admin?: boolean;
}

const { 
  title = "TextShare — Share text, code snippets & images instantly",
  description = "A minimal, blazing fast utility to share code snippets, text notes, and images securely with custom expiry times and QR codes.",
  admin = false
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    
    <!-- Inline FOUC theme initialization script -->
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      const savedTheme = localStorage.getItem("color-scheme");
      const systemPrefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const initialTheme = savedTheme || (systemPrefersDark ? "dark" : "light");
      document.documentElement.setAttribute("data-theme", initialTheme);
      document.documentElement.style.colorScheme = initialTheme;
    </script>
  </head>
  <body>
    {!admin && <Header />}
    {!admin && <MobileDrawer />}
    
    <main id="main-content">
      <div class="container">
        <slot />
      </div>
    </main>

    {!admin && <Footer />}
    {!admin && <BackToTop />}
    {!admin && <MobileBottomNav />}
    {!admin && <PricingModal />}
  </body>
</html>
