---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileDrawer from '../components/MobileDrawer.astro';
import BackToTop from '../components/BackToTop.astro';
import MobileBottomNav from '../components/MobileBottomNav.astro';
import PricingModal from '../components/PricingModal.astro';
import { getSiteSettings } from '../lib/site-settings-store';

interface Props {
  title?: string;
  description?: string;
  admin?: boolean;
}

const siteSettings = await getSiteSettings();

const { 
  title = siteSettings.metaTitle,
  description = siteSettings.metaDescription,
  admin = false
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png?v=3" />
    <link rel="shortcut icon" type="image/png" href="/favicon.png?v=3" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    
    <!-- Runs before paint and remains compatible with the strict CSP. -->
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Trusted Types default policy: keeps existing DOM-string sinks (innerHTML
      // in the admin editor, dashboard feedback, settings rows) working under the
      // `require-trusted-types-for` CSP directive.
      if (window.trustedTypes && trustedTypes.createPolicy) {
        trustedTypes.createPolicy("default", {
          createHTML: (s) => s,
          createScript: (s) => s,
          createScriptURL: (s) => s
        });
      }
      const savedTheme = localStorage.getItem("color-scheme");
      const systemPrefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const initialTheme = savedTheme || (systemPrefersDark ? "dark" : "light");
      document.documentElement.setAttribute("data-theme", initialTheme);
      document.documentElement.style.colorScheme = initialTheme;
    </script>
    {
      siteSettings.headerMetaTags && (
        <Fragment set:html={siteSettings.headerMetaTags} />
      )
    }
  </head>
  <body>
    {!admin && <Header />}
    {!admin && <MobileDrawer />}
    
    <main id="main-content">
      <div class="container">
        <slot />
      </div>
    </main>

    {!admin && <Footer />}
    {!admin && <BackToTop />}
    {!admin && <MobileBottomNav />}
    {!admin && <PricingModal />}
    {
      siteSettings.footerScripts && (
        <Fragment set:html={siteSettings.footerScripts} />
      )
    }
  </body>
</html>
