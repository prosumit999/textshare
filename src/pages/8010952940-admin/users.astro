---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { countActiveSessions, getCurrentUser, invalidateUserSessions, listUsers, setUserDisabled } from '../../lib/auth';
import { recordAudit } from '../../lib/admin';

const admin = getCurrentUser(Astro.cookies)!;
let message = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action')?.toString();
  const email = form.get('email')?.toString().toLowerCase() || '';
  if (email && email !== admin.email) {
    if (action === 'disable' && setUserDisabled(email, true)) {
      recordAudit({ actor: admin.email, action: 'disable', resourceType: 'user', resourceId: email, details: 'Account disabled and sessions revoked' }); message = `${email} disabled.`;
    } else if (action === 'enable' && setUserDisabled(email, false)) {
      recordAudit({ actor: admin.email, action: 'enable', resourceType: 'user', resourceId: email, details: 'Account restored' }); message = `${email} enabled.`;
    } else if (action === 'logout') {
      const removed = invalidateUserSessions(email); recordAudit({ actor: admin.email, action: 'force_logout', resourceType: 'user', resourceId: email, details: `${removed} sessions invalidated` }); message = `${removed} sessions invalidated.`;
    }
  }
}
const search = Astro.url.searchParams.get('q')?.trim().toLowerCase() || '';
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const perPage = 20;
const filtered = listUsers().filter((user)=>!search || `${user.name} ${user.email}`.toLowerCase().includes(search)).sort((a,b)=>b.createdAt.getTime()-a.createdAt.getTime());
const totalPages = Math.max(1, Math.ceil(filtered.length/perPage));
const users = filtered.slice((page-1)*perPage,page*perPage);
---

<AdminLayout title="User management">
  {message&&<div class="admin-alert success">{message}</div>}
  <section class="admin-panel">
    <div class="admin-panel-heading"><div><h2>Registered users</h2><p>{filtered.length} matching accounts</p></div></div>
    <form method="GET" class="admin-filter-bar"><input class="text-input" name="q" value={search} placeholder="Search name or email"/><button class="btn btn-secondary">Search</button></form>
    <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>User</th><th>Plan</th><th>Joined</th><th>Sessions</th><th>Status</th><th>Actions</th></tr></thead><tbody>
      {users.map((user)=><tr><td><strong>{user.name}</strong><small>{user.email}</small></td><td>{user.plan}</td><td>{user.createdAt.toLocaleString()}</td><td>{countActiveSessions(user.email)}</td><td><span class:list={["admin-tag",user.disabled?'danger':'published']}>{user.isAdmin?'Admin':user.disabled?'Disabled':'Active'}</span></td><td>{!user.isAdmin&&<div class="admin-row-actions"><form method="POST" onsubmit={`return confirm('${user.disabled?'Enable':'Disable'} this account?')`}><input type="hidden" name="action" value={user.disabled?'enable':'disable'}/><input type="hidden" name="email" value={user.email}/><button class={user.disabled?'':'danger-link'}>{user.disabled?'Enable':'Disable'}</button></form><form method="POST" onsubmit="return confirm('Force this user to sign in again on every device?')"><input type="hidden" name="action" value="logout"/><input type="hidden" name="email" value={user.email}/><button>Force logout</button></form></div>}</td></tr>)}
      {users.length===0&&<tr><td colspan="6" class="admin-empty">No users found.</td></tr>}
    </tbody></table></div>
    <div class="admin-pagination"><a aria-disabled={page<=1} href={`?q=${search}&page=${page-1}`}>Previous</a><span>Page {page} of {totalPages}</span><a aria-disabled={page>=totalPages} href={`?q=${search}&page=${page+1}`}>Next</a></div>
  </section>
</AdminLayout>
