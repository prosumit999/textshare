---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { deleteBlogPost, getBlogPost, getBlogPosts, recordAudit, saveBlogPost, slugify } from '../../lib/admin';
import { getCurrentUser } from '../../lib/auth';
import { sanitizeBlogHtml } from '../../lib/blog-content';

const admin = getCurrentUser(Astro.cookies)!;
let message = '';
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action')?.toString();
  const id = form.get('id')?.toString();
  if (action === 'delete' && id) {
    const post = getBlogPost(id);
    if (post && deleteBlogPost(id)) {
      recordAudit({ actor: admin.email, action: 'delete', resourceType: 'blog_post', resourceId: id, details: post.title });
      message = 'Post deleted.';
    }
  } else if (action === 'save') {
    const title = form.get('title')?.toString().trim() || '';
    const manualSlug = form.get('slug')?.toString().trim() || '';
    const rawContent = form.get('content')?.toString() || '';
    const content = sanitizeBlogHtml(rawContent);
    const coverImage = form.get('coverImage')?.toString().trim() || '';
    const validCoverImage = !coverImage || coverImage.startsWith('https://');
    const status = form.get('status') === 'published' ? 'published' : 'draft';
    const slug = slugify(manualSlug || title);
    if (title.length < 3 || title.length > 160 || !slug || !content.trim() || rawContent.length > 200000 || !validCoverImage) error = 'Check the title, slug, content length, and HTTPS featured image URL.';
    else if (getBlogPosts().some((post) => post.slug === slug && post.id !== id)) error = 'That slug is already in use.';
    else {
      const post = saveBlogPost({ id, title, slug, content, coverImage, status, publishDate: status === 'published' ? new Date() : null });
      recordAudit({ actor: admin.email, action: id ? 'update' : 'create', resourceType: 'blog_post', resourceId: post.id, details: `${post.title} (${status})` });
      message = 'Post saved.';
    }
  }
}

const search = Astro.url.searchParams.get('q')?.trim().toLowerCase() || '';
const statusFilter = Astro.url.searchParams.get('status') || 'all';
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);
const perPage = 15;
const filtered = getBlogPosts().filter((post) => (!search || `${post.title} ${post.slug}`.toLowerCase().includes(search)) && (statusFilter === 'all' || post.status === statusFilter)).sort((a,b) => b.updatedAt.getTime() - a.updatedAt.getTime());
const totalPages = Math.max(1, Math.ceil(filtered.length / perPage));
const posts = filtered.slice((page - 1) * perPage, page * perPage);
const editPost = Astro.url.searchParams.get('edit') ? getBlogPost(Astro.url.searchParams.get('edit')!) : null;
const previewPost = Astro.url.searchParams.get('preview') ? getBlogPost(Astro.url.searchParams.get('preview')!) : null;
const previewHtml = previewPost ? sanitizeBlogHtml(previewPost.content) : '';
---

<AdminLayout title="Blog management">
  {message && <div class="admin-alert success">{message}</div>}{error && <div class="admin-alert danger">{error}</div>}
  <div class="admin-blog-stack">
    <section class="admin-panel">
      <div class="admin-panel-heading"><div><h2>All blog posts</h2><p>{filtered.length} matching posts</p></div><a href="/8010952940-admin/blog?edit=new#blog-editor" class="btn btn-primary">New post</a></div>
      <form method="GET" class="admin-filter-bar"><input class="text-input" name="q" value={search} placeholder="Search title or slug" /><select class="select-input" name="status"><option value="all">All statuses</option><option value="draft" selected={statusFilter==='draft'}>Draft</option><option value="published" selected={statusFilter==='published'}>Published</option></select><button class="btn btn-secondary">Filter</button></form>
      <div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Post</th><th>Status</th><th>Published</th><th>Actions</th></tr></thead><tbody>
        {posts.map((post) => <tr><td><div class="admin-post-cell">{post.coverImage ? <img src={post.coverImage} alt=""/> : <span class="admin-post-placeholder">Aa</span>}<div><strong>{post.title}</strong><small>/{post.slug}</small></div></div></td><td><span class:list={["admin-tag", post.status]}>{post.status}</span></td><td>{post.publishDate?.toLocaleDateString() || '—'}</td><td><div class="admin-row-actions">{post.status === 'published' && <a class="admin-view-link" href={`/blog/${post.slug}`} target="_blank">View</a>}<a href={`/8010952940-admin/blog?edit=${post.id}#blog-editor`}>Edit</a><a href={`/8010952940-admin/blog?preview=${post.id}#blog-editor`}>Preview</a><form method="POST" onsubmit="return confirm('Delete this post permanently?')"><input type="hidden" name="action" value="delete"/><input type="hidden" name="id" value={post.id}/><button class="danger-link">Delete</button></form></div></td></tr>)}
        {posts.length === 0 && <tr><td colspan="4" class="admin-empty">No posts found.</td></tr>}
      </tbody></table></div>
      <div class="admin-pagination"><a aria-disabled={page<=1} href={`?q=${search}&status=${statusFilter}&page=${page-1}`}>Previous</a><span>Page {page} of {totalPages}</span><a aria-disabled={page>=totalPages} href={`?q=${search}&status=${statusFilter}&page=${page+1}`}>Next</a></div>
    </section>

    <section class="admin-panel admin-editor-panel" id="blog-editor">
      {previewPost ? <><div class="admin-panel-heading"><div><h2>Post preview</h2><p>/{previewPost.slug}</p></div><a href="/8010952940-admin/blog">Close</a></div>{previewPost.coverImage && <img class="admin-cover-preview" src={previewPost.coverImage} alt=""/>}<h1 class="admin-preview-title">{previewPost.title}</h1><div class="admin-rich-preview" set:html={previewHtml}></div></> : <>
        <div class="admin-panel-heading"><div><h2>{editPost ? 'Edit post' : 'Create post'}</h2><p>Format your article, insert images, lists, links, code, and tables.</p></div></div>
        <form method="POST" class="admin-editor-form rich-post-form"><input type="hidden" name="action" value="save"/><input type="hidden" name="id" value={editPost?.id || ''}/><div class="admin-editor-grid"><label>Title<input class="text-input" name="title" maxlength="160" required value={editPost?.title || ''}/></label><label>Slug<input class="text-input" name="slug" maxlength="80" placeholder="Generated from title" value={editPost?.slug || ''}/></label></div><div class="featured-image-field"><label>Featured image URL<input id="featured-image-url" class="text-input" name="coverImage" type="url" placeholder="Leave empty to use the generated TextShare visual" value={editPost?.coverImage || ''}/></label><div class="featured-upload-row"><input id="featured-image-file" type="file" accept="image/png,image/jpeg,image/webp"/><button id="upload-featured-image" type="button" class="btn btn-secondary">Upload to Cloudinary</button><span id="featured-upload-status" aria-live="polite">PNG, JPG or WEBP · max 5 MB</span></div><img id="featured-image-preview" class:list={["featured-image-preview", { visible: editPost?.coverImage }]} src={editPost?.coverImage || ''} alt="Featured image preview"/></div><label>Content</label><div class="rich-editor-shell"><div class="rich-editor-toolbar" role="toolbar" aria-label="Text formatting"><button type="button" data-block="h2">H2</button><button type="button" data-block="h3">H3</button><button type="button" data-command="bold"><strong>B</strong></button><button type="button" data-command="italic"><em>I</em></button><button type="button" data-command="underline"><u>U</u></button><span></span><button type="button" data-command="insertUnorderedList">• List</button><button type="button" data-command="insertOrderedList">1. List</button><button type="button" data-block="blockquote">Quote</button><button type="button" data-block="pre">Code</button><span></span><button type="button" data-action="link">Link</button><button type="button" data-action="image">Image</button><button type="button" data-action="table">Table</button><button type="button" data-command="undo">Undo</button></div><div id="rich-post-editor" class="rich-post-editor" contenteditable="true" role="textbox" aria-multiline="true" data-placeholder="Start writing your article…" set:html={editPost?.content || '<p></p>'}></div><textarea id="rich-post-content" name="content" hidden>{editPost?.content || ''}</textarea></div><div class="admin-editor-footer"><label>Status<select class="select-input" name="status"><option value="draft">Draft</option><option value="published" selected={editPost?.status==='published'}>Published</option></select></label><button class="btn btn-primary">Save post</button></div></form>
      </>}
    </section>
  </div>
</AdminLayout>

<script>
  const editor = document.querySelector<HTMLElement>('#rich-post-editor');
  const content = document.querySelector<HTMLTextAreaElement>('#rich-post-content');
  const form = document.querySelector<HTMLFormElement>('.rich-post-form');
  const imageFile = document.querySelector<HTMLInputElement>('#featured-image-file');
  const imageUrl = document.querySelector<HTMLInputElement>('#featured-image-url');
  const imagePreview = document.querySelector<HTMLImageElement>('#featured-image-preview');
  const uploadButton = document.querySelector<HTMLButtonElement>('#upload-featured-image');
  const uploadStatus = document.querySelector<HTMLElement>('#featured-upload-status');
  const focusEditor = () => editor?.focus();
  document.querySelectorAll<HTMLButtonElement>('.rich-editor-toolbar button').forEach((button) => button.addEventListener('click', () => {
    focusEditor();
    const command = button.dataset.command;
    const block = button.dataset.block;
    const action = button.dataset.action;
    if (command) document.execCommand(command, false);
    if (block) document.execCommand('formatBlock', false, block);
    if (action === 'link') { const url = window.prompt('Paste the link URL'); if (url) document.execCommand('createLink', false, url); }
    if (action === 'image') { const url = window.prompt('Paste an HTTPS image URL'); if (url?.startsWith('https://')) document.execCommand('insertImage', false, url); }
    if (action === 'table') document.execCommand('insertHTML', false, '<table><thead><tr><th>Heading 1</th><th>Heading 2</th></tr></thead><tbody><tr><td>Cell</td><td>Cell</td></tr></tbody></table><p><br></p>');
  }));
  form?.addEventListener('submit', () => { if (editor && content) content.value = editor.innerHTML; });
  imageUrl?.addEventListener('input', () => { if (imagePreview) { imagePreview.src = imageUrl.value; imagePreview.classList.toggle('visible', Boolean(imageUrl.value)); } });
  uploadButton?.addEventListener('click', async () => {
    const file = imageFile?.files?.[0];
    if (!file || !imageUrl || !uploadStatus) { if (uploadStatus) uploadStatus.textContent = 'Choose an image first.'; return; }
    uploadButton.disabled = true;
    uploadStatus.textContent = 'Uploading and optimizing…';
    const body = new FormData(); body.set('image', file);
    try {
      const response = await fetch('/api/admin/blog-image', { method: 'POST', body });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'Upload failed.');
      imageUrl.value = result.url;
      imageUrl.dispatchEvent(new Event('input'));
      uploadStatus.textContent = 'Upload complete.';
    } catch (error) { uploadStatus.textContent = error instanceof Error ? error.message : 'Upload failed.'; }
    finally { uploadButton.disabled = false; }
  });
</script>
