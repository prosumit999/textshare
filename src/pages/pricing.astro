---
import Layout from '../layouts/Layout.astro';

const plans = [
  {
    name: 'Free',
    description: 'For quick, occasional sharing.',
    price: '$0',
    period: 'forever',
    action: 'Start sharing',
    href: '/',
    featured: false,
    features: [
      'Text and code sharing',
      'Shares expire after 24 hours',
      'One active share at a time',
      'One image share at a time',
      'Syntax highlighting and QR codes',
      'No password protection or Quick Burn'
    ]
  },
  {
    name: 'Plus',
    description: 'For frequent sharing without limits.',
    price: '$3',
    period: 'per month',
    action: 'Choose Plus',
    href: '#',
    featured: true,
    features: [
      'Everything in Free',
      'Quick Burn links',
      'Password-protected shares',
      'Unlimited active shares',
      'Unlimited image shares',
      'Images expire after 1 hour',
      'Up to 5 MB per image'
    ]
  },
  {
    name: 'Pro',
    description: 'A full year of Plus at a lower price.',
    price: '$20',
    period: 'billed annually',
    action: 'Choose Pro',
    href: '#',
    featured: false,
    features: [
      'Everything in Plus',
      'One full year of access',
      'Save compared with monthly billing'
    ]
  }
];
---

<Layout title="Pricing — TextShare" description="Simple TextShare plans for secure text, code, and image sharing.">
  <section class="pricing-page">
    <div class="pricing-hero">
      <span class="eyebrow">Simple pricing</span>
      <h1>Share freely. Upgrade when you need more.</h1>
      <p>Start free, move to Plus for unlimited sharing, or save with annual Pro billing.</p>
    </div>

    <div class="pricing-grid">
      {plans.map((plan) => (
        <article class:list={["pricing-card", { featured: plan.featured }]}>
          {plan.featured && <span class="pricing-badge">Most popular</span>}
          <div class="pricing-card-header">
            <h2>{plan.name}</h2>
            <p>{plan.description}</p>
          </div>
          <div class="pricing-price">
            <strong>{plan.price}</strong>
            <span>{plan.period}</span>
          </div>
          <a href={plan.href} class:list={["btn", plan.featured ? "btn-primary" : "btn-secondary", "pricing-action"]}>
            {plan.action}
          </a>
          <ul class="pricing-features">
            {plan.features.map((feature) => (
              <li>
                <svg class="icon-svg" viewBox="0 0 24 24" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <p class="pricing-note">No hidden fees. Cancel anytime.</p>
  </section>
</Layout>
