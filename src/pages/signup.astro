---
import Layout from '../layouts/Layout.astro';
import { normalizeEmail, registerUser, validatePasswordStrength } from '../lib/auth';
import { issueEmailVerification } from '../lib/account-tokens';
import { checkRateLimit, getClientIp, logSecurityEvent, rateLimitResponse } from '../lib/security';
import { breachedPasswordCount } from '../lib/password-security';

let error = "";

if (Astro.request.method === "POST") {
  try {
    const signupLimit = await checkRateLimit('auth:signup', getClientIp(Astro.request), 3, 60 * 60);
    if (!signupLimit.allowed) return rateLimitResponse(signupLimit.retryAfter, 'Too many accounts created from this address. Try again later.');

    const formData = await Astro.request.formData();
    const name = formData.get("name")?.toString() || "";
    const email = formData.get("email")?.toString() || "";
    const password = formData.get("password")?.toString() || "";
    const confirmPassword = formData.get("confirmPassword")?.toString() || "";

    const passwordError = validatePasswordStrength(password);
    const emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(normalizeEmail(email));

    if (!name || !email || !password || !confirmPassword) {
      error = "Please fill in all fields.";
    } else if (name.trim().length < 2 || name.length > 80) {
      error = "Name must be between 2 and 80 characters.";
    } else if (!emailValid || email.length > 254) {
      error = "Enter a valid email address.";
    } else if (passwordError) {
      error = passwordError;
    } else if (password !== confirmPassword) {
      error = "Passwords do not match.";
    } else {
      const breachCount = await breachedPasswordCount(password);
      if (breachCount === null && import.meta.env.PROD) {
        error = "Password safety verification is temporarily unavailable. Try again shortly.";
        throw new Error('PASSWORD_SCREENING_UNAVAILABLE');
      }
      if (breachCount && breachCount > 0) {
        error = "This password appears in known data breaches. Choose a unique password.";
        await logSecurityEvent('breached_password_rejected', Astro.request);
        throw new Error('VALIDATION_FAILED');
      }
      const registered = await registerUser(name, email, password);
      if (!registered.ok) {
        error = "Unable to create account with those details.";
      } else {
        await issueEmailVerification(registered.user.email, Astro.url.origin);
        await logSecurityEvent('account_created_pending_verification', Astro.request);
        return Astro.redirect('/verify-email?sent=1');
      }
    }
  } catch (err) {
    if (!(err instanceof Error && ['VALIDATION_FAILED', 'PASSWORD_SCREENING_UNAVAILABLE'].includes(err.message))) error = "The account was created, but the verification email could not be sent. Use the verification page to resend it.";
  }
}
---

<Layout title="Sign Up — TextShare">
  <div class="auth-card">
    <h2>Create an Account</h2>
    <p class="subtitle">Join TextShare today to unlock vanity links, password protection, and custom expiries.</p>

    {error && (
      <div class="banner banner-warning" style="background-color:rgba(239, 68, 68, 0.1); border-color:rgba(239, 68, 68, 0.2); color:var(--color-danger); margin-bottom:var(--space-4);">
        {error}
      </div>
    )}

    <form method="POST" class="auth-form">
      <div class="input-label-pair">
        <label for="name-input">Full Name</label>
        <input
          type="text" 
          name="name" 
          id="name-input" 
          class="text-input" 
          placeholder="John Doe" 
          required 
          autofocus
          minlength="2"
          maxlength="80"
        />
      </div>

      <div class="input-label-pair">
        <label for="email-input">Email Address</label>
        <input
          type="email" 
          name="email" 
          id="email-input" 
          class="text-input" 
          placeholder="name@example.com" 
          required 
          maxlength="254"
        />
      </div>

      <div class="input-label-pair">
        <label for="password-input">Password (8+ characters, letters and numbers)</label>
        <input 
          type="password" 
          name="password" 
          id="password-input" 
          class="text-input" 
          placeholder="••••••••" 
          required 
          minlength="8"
          maxlength="128"
        />
      </div>

      <div class="input-label-pair">
        <label for="confirm-password-input">Confirm Password</label>
        <input 
          type="password" 
          name="confirmPassword" 
          id="confirm-password-input" 
          class="text-input" 
          placeholder="••••••••" 
          required 
          minlength="8"
          maxlength="128"
        />
      </div>

      <button type="submit" class="btn btn-primary" style="margin-top:var(--space-2); justify-content:center;">
        Create Account
      </button>
    </form>

    <div class="auth-footer">
      Already have an account? <a href="/login" style="font-weight:600;">Sign in</a>
      <br /><a href="/verify-email">Resend verification email</a>
    </div>
  </div>
</Layout>
