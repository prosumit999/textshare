---
import Layout from '../layouts/Layout.astro';
import AuthFrame from '../components/AuthFrame.astro';
import { normalizeEmail, registerUser, validatePasswordStrength } from '../lib/auth';
import { issueEmailVerification } from '../lib/account-tokens';
import { checkRateLimit, getClientIp, logSecurityEvent, rateLimitResponse } from '../lib/security';
import { breachedPasswordCount } from '../lib/password-security';

let error = "";

if (Astro.request.method === "POST") {
  try {
    // Keep local development friction-free for repeated signup testing. The
    // production build still enforces the Redis-backed per-IP creation limit.
    if (import.meta.env.PROD) {
      const signupLimit = await checkRateLimit('auth:signup', getClientIp(Astro.request), 3, 60 * 60);
      if (!signupLimit.allowed) return rateLimitResponse(signupLimit.retryAfter, 'Too many accounts created from this address. Try again later.');
    }

    const formData = await Astro.request.formData();
    const name = formData.get("name")?.toString() || "";
    const email = formData.get("email")?.toString() || "";
    const password = formData.get("password")?.toString() || "";
    const confirmPassword = formData.get("confirmPassword")?.toString() || "";

    const passwordError = validatePasswordStrength(password);
    const emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(normalizeEmail(email));

    if (!name || !email || !password || !confirmPassword) {
      error = "Please fill in all fields.";
    } else if (name.trim().length < 2 || name.length > 80) {
      error = "Name must be between 2 and 80 characters.";
    } else if (!emailValid || email.length > 254) {
      error = "Enter a valid email address.";
    } else if (passwordError) {
      error = passwordError;
    } else if (password !== confirmPassword) {
      error = "Passwords do not match.";
    } else {
      const breachCount = await breachedPasswordCount(password);
      if (breachCount === null && import.meta.env.PROD) {
        error = "Password safety verification is temporarily unavailable. Try again shortly.";
        throw new Error('PASSWORD_SCREENING_UNAVAILABLE');
      }
      if (breachCount && breachCount > 0) {
        error = "This password appears in known data breaches. Choose a unique password.";
        await logSecurityEvent('breached_password_rejected', Astro.request);
        throw new Error('VALIDATION_FAILED');
      }
      const registered = await registerUser(name, email, password);
      if (!registered.ok) {
        error = "Unable to create account with those details.";
      } else {
        await issueEmailVerification(registered.user.email, Astro.url.origin);
        await logSecurityEvent('account_created_pending_verification', Astro.request);
        return Astro.redirect('/verify-email?sent=1');
      }
    }
  } catch (err) {
    if (!(err instanceof Error && ['VALIDATION_FAILED', 'PASSWORD_SCREENING_UNAVAILABLE'].includes(err.message))) error = "The account was created, but the verification email could not be sent. Use the verification page to resend it.";
  }
}
---

<Layout title="Sign Up — TextShare">
  <AuthFrame eyebrow="Start sharing" title="Create your account" subtitle="One account for private links, custom controls, and every share you create." asideTitle="A calmer way to send something important.">

    {error && (
      <div class="banner banner-warning" role="alert">
        {error}
      </div>
    )}

    <form method="POST" class="auth-form">
      <div class="input-label-pair">
        <label for="name-input">Full Name</label>
        <div class="auth-input-wrap"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg><input
          type="text" 
          name="name" 
          id="name-input" 
          class="text-input" 
          placeholder="John Doe" 
          required 
          autofocus
          minlength="2"
          maxlength="80"
        /></div>
      </div>

      <div class="input-label-pair">
        <label for="email-input">Email Address</label>
        <div class="auth-input-wrap"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg><input
          type="email" 
          name="email" 
          id="email-input" 
          class="text-input" 
          placeholder="name@example.com" 
          required 
          maxlength="254"
        /></div>
      </div>

      <div class="input-label-pair">
        <label for="password-input">Password (8+ characters, letters and numbers)</label>
        <div class="auth-input-wrap auth-password-wrap"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg><input
          type="password" 
          name="password" 
          id="password-input" 
          class="text-input" 
          placeholder="••••••••" 
          required 
          minlength="8"
          maxlength="128"
        /><button type="button" class="auth-password-toggle" data-password-toggle data-target="password-input" aria-label="Show password" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6z"></path><circle cx="12" cy="12" r="2.5"></circle></svg></button></div>
      </div>

      <div class="input-label-pair">
        <label for="confirm-password-input">Confirm Password</label>
        <div class="auth-input-wrap auth-password-wrap"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 12 3 3 7-7"></path><rect x="3" y="3" width="18" height="18" rx="5"></rect></svg><input
          type="password" 
          name="confirmPassword" 
          id="confirm-password-input" 
          class="text-input" 
          placeholder="••••••••" 
          required 
          minlength="8"
          maxlength="128"
        /><button type="button" class="auth-password-toggle" data-password-toggle data-target="confirm-password-input" aria-label="Show password" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6z"></path><circle cx="12" cy="12" r="2.5"></circle></svg></button></div>
      </div>

      <p class="auth-form-assurance"><span>✓</span> We’ll email a secure verification link before your first sign-in.</p>
      <button type="submit" class="btn btn-primary auth-submit">
        Create account <span aria-hidden="true">→</span>
      </button>
    </form>

    <Fragment slot="footer"><p>Already have an account? <a href="/login">Sign in</a></p><p><a href="/verify-email">Resend a verification email</a></p></Fragment>
  </AuthFrame>
</Layout>
