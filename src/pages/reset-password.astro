---
import Layout from '../layouts/Layout.astro';
import { resetPasswordWithToken } from '../lib/account-tokens';
import { validatePasswordStrength } from '../lib/auth';
import { breachedPasswordCount } from '../lib/password-security';
import { checkRateLimit, getClientIp, logSecurityEvent, rateLimitResponse } from '../lib/security';

let token = Astro.url.searchParams.get('token') || '';
let error = token ? '' : 'This password-reset link is invalid.';
let complete = false;
if (Astro.request.method === 'POST') {
  const limit = await checkRateLimit('auth:password-reset-complete', getClientIp(Astro.request), 5, 60 * 60);
  if (!limit.allowed) return rateLimitResponse(limit.retryAfter);
  const form = await Astro.request.formData();
  token = form.get('token')?.toString() || '';
  const password = form.get('password')?.toString() || '';
  const confirm = form.get('confirmPassword')?.toString() || '';
  error = validatePasswordStrength(password) || '';
  if (!error && password !== confirm) error = 'Passwords do not match.';
  if (!error) {
    const breached = await breachedPasswordCount(password);
    if (breached === null && import.meta.env.PROD) error = 'Password safety verification is temporarily unavailable.';
    else if (breached && breached > 0) error = 'This password appears in known data breaches. Choose a unique password.';
  }
  if (!error) {
    const email = await resetPasswordWithToken(token, password);
    if (email) {
      complete = true;
      await logSecurityEvent('password_reset_completed', Astro.request);
    } else error = 'This password-reset link is invalid, expired, or has already been used.';
  }
}
---

<Layout title="Choose New Password — TextShare" description="Set a new secure TextShare password.">
  <div class="auth-card">
    <h2>{complete ? 'Password updated' : 'Choose a new password'}</h2>
    <p class="subtitle">{complete ? 'All previously signed-in devices have been logged out.' : 'Use a unique password with letters and numbers.'}</p>
    {error && <div class="banner banner-warning" role="alert">{error}</div>}
    {complete ? <a class="btn btn-primary auth-submit" href="/login">Sign in with new password</a> : token && <form method="POST" class="auth-form">
      <input type="hidden" name="token" value={token} />
      <div class="input-label-pair"><label for="new-password">New password</label><input id="new-password" class="text-input" type="password" name="password" minlength="8" maxlength="128" required autocomplete="new-password" /></div>
      <div class="input-label-pair"><label for="confirm-new-password">Confirm new password</label><input id="confirm-new-password" class="text-input" type="password" name="confirmPassword" minlength="8" maxlength="128" required autocomplete="new-password" /></div>
      <button class="btn btn-primary auth-submit" type="submit">Update password</button>
    </form>}
    <div class="auth-footer"><a href="/forgot-password">Request another link</a></div>
  </div>
</Layout>
