---
import Layout from '../layouts/Layout.astro';
import { format as formatCode } from 'prettier';
import bcrypt from 'bcryptjs';
import { getCurrentUser } from '../lib/auth';
import { sanitizeImage, UnsafeImageError } from '../lib/images';
import { checkRateLimit, getClientIp, logSecurityEvent, rateLimitResponse, secureCookieOptions } from '../lib/security';
import { MAX_SHARE_BYTES, pruneOversizedShares } from '../lib/shares';
import { deleteShare, hasShare, listShares, saveShare } from '../lib/share-store';
import { calculateExpiry, generateAvailableSlug, type ExpiryOption } from '../lib/share-policy';
import { getSiteSettings } from '../lib/site-settings-store';

const siteSettings = await getSiteSettings();

// SSR Check Authentication & Guest Limit
const currentUser = await getCurrentUser(Astro.cookies);
const isLoggedIn = !!currentUser;
const userPlan = currentUser?.plan || "free";
const hasPaidPlan = userPlan === "plus" || userPlan === "pro";
const hasActiveGuestShare = Astro.cookies.has("guest_share_active");
const activeGuestSlug = Astro.cookies.get("guest_share_active")?.value;
const activeGuestUrl = activeGuestSlug ? `${Astro.url.origin}/${activeGuestSlug}` : null;
const activeFreeSlug = Astro.cookies.get("free_share_active")?.value;

await pruneOversizedShares();

// Form Handling
let errors: Record<string, string> = {};
let textContent = '';
let result: {
  url: string;
  qrCode: string;
  expiryTime: string;
  isImage: boolean;
} | null = null;

if (Astro.request.method === "POST") {
  try {
    const requester = isLoggedIn ? currentUser!.email : getClientIp(Astro.request);
    const createLimit = await checkRateLimit('share:create', requester, isLoggedIn ? 30 : 5, 10 * 60);
    if (!createLimit.allowed) return rateLimitResponse(createLimit.retryAfter, 'Share creation limit reached. Try again later.');

    const formData = await Astro.request.formData();
    const contentType = formData.get("contentType")?.toString() || "text";
    textContent = formData.get("textContent")?.toString() || "";
    let expiry = formData.get("expiry")?.toString() || "24h";
    const language = formData.get("language")?.toString() || "plaintext";
    const password = formData.get("password")?.toString() || "";
    const customSlug = formData.get("customSlug")?.toString()?.trim().toLowerCase() || "";
    const urlFormat = formData.get("urlFormat")?.toString() === "number" ? "number" : "string";
    const imageFiles = formData.getAll("imageFile").filter((entry): entry is File => entry instanceof File && entry.size > 0);
    const maxImageCount = hasPaidPlan ? 5 : 1;
    const highlightEnabled = formData.get("syntaxHighlightEnabled") === "on";
    const analyticsEnabled = isLoggedIn && formData.get("analyticsEnabled") === "on";

    // Image duration is fixed by plan unless the free Burn After First View mode is selected.
    if (contentType === "image" && expiry !== "burn") expiry = hasPaidPlan ? "24h" : "3h";

    // Validation
    if (!isLoggedIn) {
      // Guest permission checks
      if (contentType === "text" && !["24h", "burn"].includes(expiry)) {
        errors.expiry = "Guests can use 24-hour expiry or Burn After First View.";
      }
      if (customSlug) {
        errors.customSlug = "Only registered users can set custom vanity URLs.";
      }
      if (password) {
        errors.password = "Only registered users can password-protect shares.";
      }
    }

    if (isLoggedIn && !hasPaidPlan) {
      if (contentType === "text" && !["24h", "burn"].includes(expiry)) {
        errors.expiry = "Free shares can use 24-hour expiry or Burn After First View.";
      }
      if (password) {
        errors.password = "Password protection is available on Plus and Pro.";
      }
      if (customSlug) {
        errors.customSlug = "Custom slugs are available on Pro.";
      }
    }

    if (contentType === "text" && !textContent.trim()) {
      errors.textContent = "Please enter some text or code content.";
    } else if (contentType === "text" && new TextEncoder().encode(textContent).byteLength > MAX_SHARE_BYTES) {
      errors.textContent = "This text is larger than 50 MB. Reduce its size before creating the share.";
    }

    if (contentType === "image" && imageFiles.length === 0) {
      errors.imageFile = "Please select at least one image.";
    } else if (contentType === "image" && imageFiles.length > maxImageCount) {
      errors.imageFile = hasPaidPlan ? "Paid shares support up to 5 images." : "Free image shares support one image. Upgrade to Pro for up to 5.";
    } else if (contentType === "image" && imageFiles.some((file) => file.size > 5 * 1024 * 1024)) {
      errors.imageFile = "Each image must not exceed 5 MB.";
    }

    if (customSlug) {
      const slugRegex = /^[a-z0-9]{3,6}$/;
      if (!slugRegex.test(customSlug)) {
        errors.customSlug = "Slug must be 3-6 lowercase letters or numbers.";
      }
      // Simple mock check for taken slugs (for demo purposes)
      if (customSlug.toLowerCase() === "admin" || customSlug.toLowerCase() === "dashboard") {
        errors.customSlug = "This custom link is already taken or reserved.";
      }
      if (await hasShare(customSlug)) {
        errors.customSlug = "This custom link is already taken.";
      }
    }

    // Process share if no validation errors
    if (Object.keys(errors).length === 0) {
      let sanitizedImages: Awaited<ReturnType<typeof sanitizeImage>>[] = [];
      if (contentType === "image" && imageFiles.length) {
        const uploadLimit = await checkRateLimit(
          'image:upload',
          isLoggedIn ? currentUser!.email : getClientIp(Astro.request),
          isLoggedIn ? 30 : 10,
          10 * 60
        );
        if (!uploadLimit.allowed) return rateLimitResponse(uploadLimit.retryAfter, 'Image upload limit reached. Try again later.');
        try {
          sanitizedImages = await Promise.all(imageFiles.map((file) => sanitizeImage(file)));
        } catch (error) {
          await logSecurityEvent('image_upload_rejected', Astro.request, { reason: error instanceof Error ? error.message : 'unknown' });
          if (error instanceof UnsafeImageError) errors.imageFile = error.message;
          else errors.imageFile = 'The image could not be processed safely.';
        }
      }

      if (Object.keys(errors).length > 0) throw new Error('VALIDATION_FAILED');

      if (contentType === "text" && highlightEnabled) {
        const prettierParsers: Record<string, string> = {
          javascript: "babel",
          typescript: "typescript",
          html: "html",
          css: "css",
          json: "json",
          markdown: "markdown"
        };
        const parser = prettierParsers[language];

        if (parser) {
          try {
            textContent = await formatCode(textContent, { parser });
          } catch {
            // Keep the original content if it is incomplete or cannot be parsed.
          }
        }
      }

      if (contentType === "text" && new TextEncoder().encode(textContent).byteLength > MAX_SHARE_BYTES) {
        errors.textContent = "Formatted content is larger than 50 MB. Reduce its size before creating the share.";
        throw new Error('VALIDATION_FAILED');
      }

      let slug = "";
      
      if (isLoggedIn && customSlug) {
        slug = customSlug;
      } else {
        slug = await generateAvailableSlug(urlFormat, hasShare);
      }

      // Calculate Expiry Date
      const expiryDate = calculateExpiry(expiry as ExpiryOption);

      // Save to global in-memory database for standalone execution
      // A guest keeps one share at a time; a new share replaces the previous one.
      if (!isLoggedIn && activeGuestSlug) {
        await deleteShare(activeGuestSlug);
      }
      if (isLoggedIn && !hasPaidPlan) {
        const existingFreeShares = await listShares(currentUser!.email);
        for (const existing of existingFreeShares) await deleteShare(existing.slug, currentUser!.email);
      }

      const imageSrcs = sanitizedImages.map((image) => image.dataUrl);
      const imageSrc = imageSrcs[0] || null;
      const passwordHash = password ? await bcrypt.hash(password, 12) : null;
      
      await saveShare(slug, {
        contentType,
        textContent,
        imageSrc,
        imageSrcs,
        expiryDate,
        burnAfterReading: expiry === "burn",
        language: highlightEnabled ? language : "plaintext",
        passwordHash,
        owner: currentUser?.email || null,
        guestIp: currentUser ? null : getClientIp(Astro.request),
        sizeBytes: contentType === "image" ? sanitizedImages.reduce((total, image) => total + image.bytes, 0) : new TextEncoder().encode(textContent).byteLength,
        createdAt: new Date(),
        viewCount: 0,
        analyticsEnabled
      });

      // Track the shares visible to this browser/account.
      if (!isLoggedIn) {
        Astro.cookies.set("guest_share_active", slug, secureCookieOptions(60 * 60 * 24));
      } else if (!hasPaidPlan) {
        Astro.cookies.set("free_share_active", slug, secureCookieOptions(60 * 60 * 24));
        Astro.cookies.set("account_share_slugs", JSON.stringify([slug]), secureCookieOptions(60 * 60 * 24 * 365));
      } else {
        let accountSlugs: string[] = [];
        try {
          accountSlugs = JSON.parse(Astro.cookies.get("account_share_slugs")?.value || "[]");
        } catch {
          accountSlugs = [];
        }
        accountSlugs = [...new Set([...accountSlugs, slug])].slice(-100);
        Astro.cookies.set("account_share_slugs", JSON.stringify(accountSlugs), secureCookieOptions(60 * 60 * 24 * 365));
      }

      if (expiry === "burn") {
        Astro.cookies.set("burn_creator_preview", slug, secureCookieOptions(5 * 60));
      }

      return Astro.redirect(`/${slug}?created=1`);
    }
  } catch (e) {
    if (!(e instanceof Error && e.message === 'VALIDATION_FAILED')) {
      errors.server = "An unexpected error occurred. Please try again.";
    }
  }
}
---

<Layout>
  <div class="creator-container">
    <div id="copy-notification" class="copy-notification" role="status" aria-live="polite" aria-atomic="true"></div>
    <div class="hero-section">
      <span class="eyebrow">{siteSettings.heroEyebrow}</span>
      <h1>{siteSettings.heroTitle}</h1>
      <p>{siteSettings.heroSubtitle}</p>
    </div>

    <!-- Active guest share recovery and replacement notice -->
    {!isLoggedIn && hasActiveGuestShare && (
      <div class="banner banner-warning">
        <svg class="icon-svg" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <div class="guest-share-recovery">
          <div>
            <strong>Your current guest share is still available.</strong>
            <span>Creating a new share will replace this one. <a href="/login">Sign in</a> to keep multiple shares.</span>
          </div>
          {activeGuestUrl && (
            <div class="guest-share-actions">
              <code id="guest-share-url">{activeGuestUrl}</code>
              <a href={activeGuestUrl} class="btn btn-primary">Open share</a>
              <button type="button" class="btn btn-secondary" id="copy-guest-share" data-url={activeGuestUrl}>Copy link</button>
            </div>
          )}
        </div>
      </div>
    )}

    {errors.server && (
      <div class="banner banner-warning" style="background-color:rgba(239, 68, 68, 0.1); border-color:rgba(239, 68, 68, 0.2); color:var(--color-danger);">
        {errors.server}
      </div>
    )}

    {result ? (
      /* Success View Component */
      <div class="result-card">
        <div class="result-header">
          <h2 style="margin: 0; color: var(--color-accent);">Share Created Successfully!</h2>
          <p style="color: var(--color-text-muted); font-size: 13px; margin-top: var(--space-2);">Your share is live and accessible at the link below.</p>
        </div>
        
        <div class="result-body">
          <div class="result-info">
            <div class="input-label-pair">
              <label>Share URL</label>
              <div class="url-copy-box">
                <div class="url-text" id="url-text-val">{result.url}</div>
                <button id="copy-url-btn" class="btn btn-primary" title="Copy link">
                  <svg class="icon-svg" viewBox="0 0 24 24" id="copy-icon">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span id="copy-btn-text">Copy</span>
                </button>
              </div>
            </div>

            <div style="font-size: 13px; margin-top: var(--space-2);">
              <strong>Expires at:</strong> <span style="color: var(--color-text-muted);">{result.expiryTime}</span>
            </div>

            <div style="margin-top: var(--space-4);">
              {isLoggedIn ? (
                <a href="/" class="btn btn-secondary">Create Another Share</a>
              ) : (
                <div class="guest-result-note">
                  <span>Creating another guest share will replace this one.</span>
                  <a href="/" class="btn btn-secondary">Create a new share</a>
                  <a href="/login" class="btn btn-secondary">Sign in to keep both</a>
                </div>
              )}
              {result.isImage && (
                <span style="font-size: 12px; display: block; color: var(--color-text-muted); margin-top: var(--space-2);">
                  (Note: In a live environment, image uploads are sent to server storage.)
                </span>
              )}
            </div>
          </div>

          <div class="qr-code-section">
            <div class="qr-container">
              <img src={result.qrCode} alt="QR Code Link" width="160" height="160" />
            </div>
            <a href={result.qrCode} download="textshare-qr.png" class="btn btn-secondary btn-sm" style="font-size:12px; padding:4px 8px;">
              <svg class="icon-svg" viewBox="0 0 24 24" style="width:14px; height:14px;">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              Scan Qr To Open This Room
            </a>
          </div>
        </div>
      </div>

      <script>
        const copyBtn = document.getElementById("copy-url-btn");
        const urlVal = document.getElementById("url-text-val")?.textContent;
        const copyIcon = document.getElementById("copy-icon");
        const copyText = document.getElementById("copy-btn-text");
        const showCopyToast = (message, isError = false) => {
          const toast = document.getElementById('copy-notification');
          if (!toast) return;
          toast.textContent = message;
          toast.classList.toggle('is-error', isError);
          toast.classList.add('is-visible');
          window.setTimeout(() => toast.classList.remove('is-visible'), 2600);
        };

        copyBtn?.addEventListener("click", async () => {
          if (urlVal) {
            try {
              await navigator.clipboard.writeText(urlVal);
              if (copyText) copyText.textContent = "Copied!";
              setTimeout(() => {
                if (copyText) copyText.textContent = "Copy";
              }, 2000);
              showCopyToast('Room link copied to clipboard.');
            } catch (err) {
              console.error("Failed to copy text: ", err);
              showCopyToast('Could not copy the room link.', true);
            }
          }
        });
      </script>

    ) : (
      /* Creator Form View */
      <form class="share-form" method="POST" enctype="multipart/form-data">
        <div class="editor-heading">
          <div>
            <span class="editor-label">New share</span>
            <span class="editor-hint">Your content is ready when you are.</span>
          </div>
          <span class="privacy-note">
            <svg class="icon-svg" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="10" rx="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            Secure link
          </span>
        </div>
        
        <!-- Content type is available to guests and signed-in users. -->
        <div class="content-tabs">
          <button type="button" id="tab-text" class="content-tab active">Text / Code</button>
          <button type="button" id="tab-image" class="content-tab">Image Upload</button>
          <input type="hidden" name="contentType" id="content-type-input" value="text" />
        </div>

        <!-- Main text content area -->
        <div class="textarea-wrapper" id="text-input-section">
          <textarea 
            id="share-text-content"
            name="textContent" 
            class="share-textarea" 
            placeholder="Type or paste your text or code snippet here..."
            aria-label="Text content"
          >{textContent}</textarea>
          <div id="share-size-feedback" class="share-size-feedback" aria-live="polite"><span>0 B</span><span>50 MB maximum</span></div>
          {errors.textContent && (
            <span style="color:var(--color-danger); font-size:12px; padding:0 var(--space-4) var(--space-2); display:block;">
              {errors.textContent}
            </span>
          )}
        </div>

        <!-- Main image upload area (hidden until selected) -->
        <div id="image-input-section" style="display: none;">
            <div class="image-upload-wrapper" id="image-drag-area">
              <input type="file" name="imageFile" id="image-file-input" aria-label="Select images to share" accept="image/png, image/jpeg, image/webp" multiple={hasPaidPlan} style="display: none;" />
              <button type="button" class="image-drop-zone" id="image-drop-zone" aria-describedby="image-expiry-hint image-selection-status">
                <svg class="icon-svg" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 16V4"></path><path d="m8 8 4-4 4 4"></path><path d="M5 14v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4"></path>
                </svg>
                <span><strong>Drag and drop {hasPaidPlan ? 'images' : 'an image'} here</strong><span>or <em>choose files</em> to upload · PNG, JPG, WEBP</span></span>
                <small id="image-expiry-hint">{hasPaidPlan ? 'Pro: up to 5 images · expires in 24 hours' : 'One image · expires in 3 hours'} · 5 MB per image</small>
              </button>
              <div id="image-preview-grid" class:list={["image-preview-grid", { single: !hasPaidPlan }]} data-max={hasPaidPlan ? 5 : 1} hidden></div>
              <div class="image-upload-footer"><span id="image-selection-status" aria-live="polite">0 / {hasPaidPlan ? 5 : 1} selected</span></div>
            </div>
            {errors.imageFile && (
              <span style="color:var(--color-danger); font-size:12px; padding:var(--space-2) var(--space-4); display:block;">
                {errors.imageFile}
              </span>
            )}
        </div>

        <!-- Bottom Controls Bar -->
        <div class="form-controls">
          <div class="control-group-left">
            <!-- Syntax highlighting toggle -->
            <div id="syntax-highlight-toggle-wrapper" style="display: flex; align-items: center; gap: var(--space-2);">
              <label class="checkbox-label">
                <input type="checkbox" name="syntaxHighlightEnabled" id="syntax-highlight-toggle" class="checkbox-input" />
                <span>Syntax highlighting</span>
              </label>
              <select name="language" id="language-select" class="select-input" aria-label="Code language" style="display: none;">
                <option value="plaintext">Plain Text</option>
                <option value="javascript">JavaScript</option>
                <option value="typescript">TypeScript</option>
                <option value="html">HTML</option>
                <option value="css">CSS</option>
                <option value="python">Python</option>
                <option value="json">JSON</option>
                <option value="markdown">Markdown</option>
              </select>
            </div>

            <!-- Expiry Dropdown -->
            <div style="display: flex; align-items: center; gap: var(--space-2);">
              <label for="expiry-select" style="font-size: 13px;">Expires in:</label>
              <select name="expiry" id="expiry-select" class="select-input">
                {isLoggedIn && hasPaidPlan ? (
                  <option value="24h" selected>24 hours</option>
                  <option value="1w">1 week</option>
                  <option value="1m">1 month</option>
                  <option value="1y">1 year</option>
                  <option value="burn">Burn after first view · Free</option>
                ) : (
                  <>
                    <option value="24h" selected>24 hours</option>
                    <option value="burn">Burn after first view · Free</option>
                    <option value="1w" data-premium="true">🔒 1 week · Pro</option>
                    <option value="1m" data-premium="true">🔒 1 month · Pro</option>
                    <option value="1y" data-premium="true">🔒 1 year · Pro</option>
                  </>
                )}
              </select>
              <span id="burn-flame" class="burn-flame" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M13.4 2.7c.5 3.2-1.8 4.5-3 6.5-1-1-1.3-2-1.1-3.3C6.9 8 5 10.5 5 14a7 7 0 0 0 14 0c0-4.7-2.8-8.5-5.6-11.3Z"></path><path d="M9.2 16.1c0 1.7 1.2 3 2.8 3s2.8-1.3 2.8-3c0-1.4-.8-2.7-2.1-4.1-.1 1.5-.8 2.2-1.5 3-.5-.6-.8-1.2-.7-2-1 .9-1.3 1.9-1.3 3.1Z"></path></svg>
              </span>
            </div>

            <!-- Access analytics opt-in -->
            {isLoggedIn && (
              <label class="checkbox-label" title="Record anonymous view timestamps and country for this share.">
                <input type="checkbox" name="analyticsEnabled" id="analytics-toggle" class="checkbox-input" />
                <span>Track access analytics</span>
              </label>
            )}

            <fieldset class="link-style-control">
              <legend>Link style</legend>
              <label>
                <input type="radio" name="urlFormat" value="string" checked />
                <span>Letters</span>
              </label>
              <label>
                <input type="radio" name="urlFormat" value="number" />
                <span>Numbers</span>
              </label>
            </fieldset>

            {!hasPaidPlan && (
              <a class="premium-unlock" href="/pricing" aria-label="View premium sharing features" title="Unlock custom expiry, password protection, and more">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 7.7-1.5"></path><path d="m15 5 2-2 2 2"></path></svg>
                <span>Unlock more</span>
              </a>
            )}

            {isLoggedIn && (
              <>
                {hasPaidPlan && (
                  <div class="inline-password-control">
                    <label class="checkbox-label">
                      <input type="checkbox" id="password-toggle" class="checkbox-input" />
                      <span>Password protect</span>
                    </label>
                    <input
                      type="password"
                      name="password"
                      id="password-input"
                      class="text-input compact-control-input"
                      placeholder="Password"
                      aria-label="Share password"
                      style="display: none;"
                    />
                  </div>
                )}

                {hasPaidPlan && (
                  <div class="inline-slug-control">
                    <label for="custom-slug-input">Custom slug</label>
                    <span>/</span>
                    <input
                      type="text"
                      name="customSlug"
                      id="custom-slug-input"
                      class="text-input compact-control-input"
                      placeholder="myurl1"
                      minlength="3"
                      maxlength="6"
                      pattern="[a-z0-9]{3,6}"
                      aria-describedby="slug-availability-msg"
                    />
                    <span id="slug-availability-msg" class="inline-availability-msg" style="display: none;"></span>
                  </div>
                )}

              </>
            )}
          </div>

          <!-- Submit Button -->
          <button 
            type="submit" 
            class="btn btn-primary create-share-btn"
          >
            Create Share
          </button>
        </div>

        {isLoggedIn && (errors.password || errors.customSlug) && (
          <div class="inline-errors-row">
            {errors.password && <span class="inline-form-error">{errors.password}</span>}
            {errors.customSlug && <span class="inline-form-error">{errors.customSlug}</span>}
          </div>
        )}
      </form>

      <script>
        // Interactive Client-side Scripting
        
        // Tab switching Text vs Image
        const tabText = document.getElementById("tab-text");
        const tabImage = document.getElementById("tab-image");
        const contentTypeInput = document.getElementById("content-type-input") as HTMLInputElement;
        const textInputSection = document.getElementById("text-input-section");
        const imageInputSection = document.getElementById("image-input-section");
        const syntaxHighlightWrapper = document.getElementById("syntax-highlight-toggle-wrapper");
        const shareForm = document.querySelector<HTMLFormElement>('.share-form');
        const shareText = document.getElementById('share-text-content') as HTMLTextAreaElement | null;
        const sizeFeedback = document.getElementById('share-size-feedback');
        const createButton = document.querySelector<HTMLButtonElement>('.create-share-btn');
        const expirySelect = document.getElementById('expiry-select') as HTMLSelectElement | null;
        const burnFlame = document.getElementById('burn-flame');
        const imageExpiryHint = document.getElementById('image-expiry-hint');
        const maxShareBytes = 50 * 1024 * 1024;

        let lastAvailableExpiry = expirySelect?.value || '24h';
        const updateBurnState = () => {
          const burnsAfterView = expirySelect?.value === 'burn';
          burnFlame?.classList.toggle('active', burnsAfterView);
          if (imageExpiryHint) imageExpiryHint.textContent = burnsAfterView
            ? 'Deleted after the first recipient view · 5 MB per image'
            : `${document.querySelector<HTMLInputElement>('#image-file-input')?.multiple ? 'Pro: up to 5 images · expires in 24 hours' : 'One image · expires in 3 hours'} · 5 MB per image`;
        };
        expirySelect?.addEventListener('change', () => {
          const selected = expirySelect.selectedOptions[0];
          if (selected?.dataset.premium === 'true') {
            expirySelect.value = lastAvailableExpiry;
            document.dispatchEvent(new CustomEvent('textshare:pricing'));
          } else {
            lastAvailableExpiry = expirySelect.value;
          }
          updateBurnState();
        });

        const updateTextSize = () => {
          if (!shareText || !sizeFeedback) return;
          const bytes = new TextEncoder().encode(shareText.value).byteLength;
          const current = sizeFeedback.querySelector('span');
          if (current) current.textContent = bytes < 1024 * 1024 ? `${(bytes / 1024).toFixed(bytes < 1024 ? 1 : 0)} KB` : `${(bytes / 1024 / 1024).toFixed(1)} MB`;
          const oversized = bytes > maxShareBytes;
          sizeFeedback.classList.toggle('oversized', oversized);
          if (createButton && contentTypeInput?.value === 'text') createButton.disabled = oversized;
          sizeFeedback.lastElementChild!.textContent = oversized ? 'Text exceeds the 50 MB limit' : '50 MB maximum';
        };
        shareText?.addEventListener('input', updateTextSize);
        const extensionShare = new URLSearchParams(window.location.hash.slice(1)).get('share');
        if (shareText && extensionShare) {
          shareText.value = extensionShare;
          updateTextSize();
          shareText.focus();
          window.history.replaceState({}, document.title, `${window.location.pathname}${window.location.search}`);
        }
        shareForm?.addEventListener('submit', (event) => {
          if (contentTypeInput?.value === 'text' && shareText && new TextEncoder().encode(shareText.value).byteLength > maxShareBytes) {
            event.preventDefault();
            updateTextSize();
            shareText.focus();
          }
        });
        updateTextSize();

        if (tabText && tabImage && contentTypeInput) {
          tabText.addEventListener("click", () => {
            tabText.classList.add("active");
            tabText.style.backgroundColor = "var(--color-bg-surface)";
            tabImage.classList.remove("active");
            tabImage.style.backgroundColor = "transparent";
            contentTypeInput.value = "text";
            if (textInputSection) textInputSection.style.display = "block";
            if (imageInputSection) imageInputSection.style.display = "none";
            if (syntaxHighlightWrapper) syntaxHighlightWrapper.style.display = "flex";
            updateTextSize();
            updateBurnState();
          });

          tabImage.addEventListener("click", () => {
            tabImage.classList.add("active");
            tabImage.style.backgroundColor = "var(--color-bg-surface)";
            tabText.classList.remove("active");
            tabText.style.backgroundColor = "transparent";
            contentTypeInput.value = "image";
            if (textInputSection) textInputSection.style.display = "none";
            if (imageInputSection) imageInputSection.style.display = "block";
            if (syntaxHighlightWrapper) syntaxHighlightWrapper.style.display = "none";
            if (createButton) createButton.disabled = false;
            updateBurnState();
          });
        }
        updateBurnState();

        // Image Drag/Click upload logic
        const imageDragArea = document.getElementById("image-drag-area");
        const imageFileInput = document.getElementById("image-file-input") as HTMLInputElement;
        const imageDropZone = document.getElementById('image-drop-zone');
        const imageGrid = document.getElementById('image-preview-grid');
        const addImagesButton = document.getElementById('add-images-btn');
        const imageSelectionStatus = document.getElementById('image-selection-status');
        const maxImages = Number(imageGrid?.dataset.max || 1);
        let selectedImages: File[] = [];
        let previewUrls: string[] = [];

        const syncImageInput = () => {
          const transfer = new DataTransfer();
          selectedImages.forEach((file) => transfer.items.add(file));
          imageFileInput.files = transfer.files;
        };
        const renderImageGrid = () => {
          previewUrls.forEach((url) => URL.revokeObjectURL(url));
          previewUrls = [];
          if (!imageGrid) return;
          imageGrid.replaceChildren();
          imageGrid.toggleAttribute('hidden', selectedImages.length === 0);
          selectedImages.forEach((selectedImage, index) => {
            const slot = document.createElement('div');
            slot.className = 'image-grid-slot filled';
            const url = URL.createObjectURL(selectedImage);
            previewUrls.push(url);
            const image = document.createElement('img');
            image.src = url;
            image.alt = `Selected image ${index + 1}`;
            const remove = document.createElement('button');
            remove.type = 'button';
            remove.className = 'image-grid-remove';
            remove.dataset.removeImage = String(index);
            remove.setAttribute('aria-label', `Remove image ${index + 1}`);
            remove.textContent = '×';
            slot.append(image, remove);
            imageGrid.append(slot);
          });
          if (imageSelectionStatus) imageSelectionStatus.textContent = `${selectedImages.length} / ${maxImages} selected`;
          if (addImagesButton instanceof HTMLButtonElement) addImagesButton.disabled = selectedImages.length >= maxImages;
        };
        const openImagePicker = () => { if (selectedImages.length < maxImages) imageFileInput.click(); };
        const addImages = (incoming: File[]) => {
          const known = new Set(selectedImages.map((file) => `${file.name}:${file.size}:${file.lastModified}`));
          let rejected = 0;
          for (const file of incoming) {
            const key = `${file.name}:${file.size}:${file.lastModified}`;
            const supported = ['image/png', 'image/jpeg', 'image/webp'].includes(file.type);
            if (!supported || file.size > 5 * 1024 * 1024 || known.has(key) || selectedImages.length >= maxImages) {
              rejected += 1;
              continue;
            }
            selectedImages.push(file);
            known.add(key);
          }
          syncImageInput();
          renderImageGrid();
          if (imageSelectionStatus && rejected) imageSelectionStatus.textContent = `${selectedImages.length} / ${maxImages} selected · ${rejected} file${rejected === 1 ? '' : 's'} skipped`;
        };
        addImagesButton?.addEventListener('click', openImagePicker);
        imageDropZone?.addEventListener('click', openImagePicker);
        ['dragenter', 'dragover'].forEach((eventName) => imageDropZone?.addEventListener(eventName, (event) => {
          event.preventDefault();
          imageDropZone.classList.add('is-dragging');
        }));
        ['dragleave', 'drop'].forEach((eventName) => imageDropZone?.addEventListener(eventName, (event) => {
          event.preventDefault();
          imageDropZone.classList.remove('is-dragging');
        }));
        imageDropZone?.addEventListener('drop', (event) => {
          addImages(Array.from((event as DragEvent).dataTransfer?.files || []));
        });
        imageGrid?.addEventListener('click', (event) => {
          const target = event.target as HTMLElement;
          const remove = target.closest<HTMLButtonElement>('[data-remove-image]');
          if (remove) {
            selectedImages.splice(Number(remove.dataset.removeImage), 1);
            syncImageInput();
            renderImageGrid();
          }
        });
        imageFileInput.addEventListener('change', () => {
          addImages(Array.from(imageFileInput.files || []));
        });
        renderImageGrid();

        // Syntax Highlighter Selector Toggle
        const syntaxHighlightCheckbox = document.getElementById("syntax-highlight-toggle") as HTMLInputElement;
        const languageSelect = document.getElementById("language-select") as HTMLSelectElement;

        if (syntaxHighlightCheckbox && languageSelect) {
          syntaxHighlightCheckbox.addEventListener("change", () => {
            languageSelect.style.display = syntaxHighlightCheckbox.checked ? "inline-block" : "none";
          });
        }

        // Password input field reveal (Logged In only)
        const passwordCheckbox = document.getElementById("password-toggle") as HTMLInputElement;
        const passwordInput = document.getElementById("password-input") as HTMLInputElement;

        if (passwordCheckbox && passwordInput) {
          passwordCheckbox.addEventListener("change", () => {
            passwordInput.style.display = passwordCheckbox.checked ? "block" : "none";
            if (passwordCheckbox.checked) passwordInput.focus();
          });
        }

        // Vanity custom slug real-time mock uniqueness check (Logged In only)
        const slugInput = document.getElementById("custom-slug-input") as HTMLInputElement;
        const availabilityMsg = document.getElementById("slug-availability-msg");

        if (slugInput && availabilityMsg) {
          slugInput.addEventListener("input", () => {
            const slug = slugInput.value.trim().toLowerCase();
            if (!slug) {
              availabilityMsg.style.display = "none";
              return;
            }

            slugInput.value = slug.replace(/[^a-z0-9]/g, "").slice(0, 6);

            if (slugInput.value.length < 3) {
              availabilityMsg.style.display = "block";
              availabilityMsg.textContent = "Too short";
              availabilityMsg.style.color = "var(--color-danger)";
              return;
            }

            // Mock check
            availabilityMsg.style.display = "block";
            if (slug === "admin" || slug === "dashboard" || slug === "taken") {
              availabilityMsg.textContent = "Already taken";
              availabilityMsg.style.color = "var(--color-danger)";
            } else {
              availabilityMsg.textContent = "Link is available";
              availabilityMsg.style.color = "green";
            }
          });
        }
      </script>
    )}
  </div>

  <!-- SEO Section -->
  <section class="home-seo-section">
    <header class="seo-header">
      <h2>{siteSettings.seoTitle}</h2>
    </header>
    <div class="seo-rich-content" set:html={siteSettings.seoContent}></div>
  </section>
</Layout>

