  .home-seo-section {
    margin-top: 48px;
    margin-bottom: 32px;
    padding: 32px;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background: var(--color-bg-surface);
    box-shadow: 0 8px 32px color-mix(in srgb, var(--color-text-base) 3%, transparent);
  }
  .seo-header h2 {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 24px;
    text-align: center;
    width: 100%;
    color: var(--color-text-base);
  }
  .seo-rich-content {
    color: #2c2e31;
    font-size: 14.5px;
    line-height: 1.7;
  }
  .seo-rich-content h2 {
    font-size: 18px;
    font-weight: 750;
    margin-top: 28px;
    margin-bottom: 12px;
    color: var(--color-text-base);
  }
  .seo-rich-content h3 {
    font-size: 15px;
    font-weight: 700;
    margin-top: 24px;
    margin-bottom: 10px;
    color: var(--color-text-base);
  }
  .seo-rich-content p {
    margin-bottom: 16px;
  }
  .seo-rich-content ul, .seo-rich-content ol {
    margin-bottom: 16px;
    padding-left: 20px;
  }
  .seo-rich-content li {
    margin-bottom: 8px;
    color: var(--color-text-base);
  }
  .seo-rich-content img {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    margin: 20px 0;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  }
</style>

{activeGuestUrl && (
  <script>
    const guestCopyButton = document.getElementById('copy-guest-share');
    const showCopyToast = (message, isError = false) => {
      const toast = document.getElementById('copy-notification');
      if (!toast) return;
      toast.textContent = message;
      toast.classList.toggle('is-error', isError);
      toast.classList.add('is-visible');
      window.setTimeout(() => toast.classList.remove('is-visible'), 2600);
    };
    guestCopyButton?.addEventListener('click', async () => {
      const url = guestCopyButton.getAttribute('data-url');
      if (!url) return;

      try {
        await navigator.clipboard.writeText(url);
        guestCopyButton.textContent = 'Copied!';
        window.setTimeout(() => guestCopyButton.textContent = 'Copy link', 2000);
        showCopyToast('Room link copied to clipboard.');
      } catch {
        const urlElement = document.getElementById('guest-share-url');
        const selection = window.getSelection();
        if (urlElement && selection) {
          const range = document.createRange();
          range.selectNodeContents(urlElement);
          selection.removeAllRanges();
          selection.addRange(range);
        }
        showCopyToast('Could not copy the room link.', true);
      }
    });
  </script>
)}
