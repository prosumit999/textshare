---
import Layout from '../layouts/Layout.astro';
import { getCurrentUser } from '../lib/auth';
import { checkRateLimit, getClientIp, rateLimitResponse, secureCookieOptions } from '../lib/security';
import { deleteShare, getShare, listShares } from '../lib/share-store';

const currentUser = await getCurrentUser(Astro.cookies);
const isLoggedIn = !!currentUser;
const guestSlug = Astro.cookies.get("guest_share_active")?.value;
const userPlan = currentUser?.plan || "free";
const freeShareSlug = Astro.cookies.get("free_share_active")?.value;
let accountSlugs: string[] = [];
try {
  accountSlugs = JSON.parse(Astro.cookies.get("account_share_slugs")?.value || "[]");
} catch {
  accountSlugs = [];
}

// Handle share deletion
let message = "";
if (Astro.request.method === "POST") {
  try {
    const deleteLimit = await checkRateLimit(
      'share:delete',
      currentUser?.email || getClientIp(Astro.request),
      30,
      10 * 60
    );
    if (!deleteLimit.allowed) return rateLimitResponse(deleteLimit.retryAfter);

    const formData = await Astro.request.formData();
    const action = formData.get("action")?.toString();
    const deleteSlug = formData.get("slug")?.toString();

    if (action === "delete" && deleteSlug) {
      const storedShare = await getShare(deleteSlug);
      const canDelete = isLoggedIn
        ? storedShare?.owner === currentUser?.email
        : deleteSlug === guestSlug && !storedShare?.owner;
      if (canDelete && await deleteShare(deleteSlug, isLoggedIn ? currentUser!.email : undefined)) {
        if (!isLoggedIn && deleteSlug === guestSlug) {
          Astro.cookies.delete("guest_share_active", { path: "/" });
        }
        if (isLoggedIn) {
          accountSlugs = accountSlugs.filter((slug) => slug !== deleteSlug);
          Astro.cookies.set("account_share_slugs", JSON.stringify(accountSlugs), secureCookieOptions(60 * 60 * 24 * 365));
          if (deleteSlug === freeShareSlug) {
            Astro.cookies.delete("free_share_active", { path: "/" });
          }
        }
        message = `Successfully deleted share /${deleteSlug}.`;
      }
    }
  } catch (err) {
    message = "An error occurred while deleting.";
  }
}

// Fetch current shares
const guestShare = !isLoggedIn && guestSlug ? await getShare(guestSlug) : null;
const visibleEntries = isLoggedIn
  ? await listShares(currentUser!.email)
  : guestSlug && guestShare ? [{ slug: guestSlug, ...guestShare }] : [];

const shares = visibleEntries.map((data: any) => {
  const slug = data.slug;
  const isExpired = new Date() > new Date(data.expiryDate);
  return {
    slug,
    type: data.contentType,
    expiry: new Date(data.expiryDate).toLocaleString(),
    isExpired,
    passwordProtected: !!data.passwordHash,
    url: `${Astro.url.origin}/${slug}`
  };
});
---

<Layout title="All Shares — TextShare">
  <div class="dashboard-container">
    <div class="dashboard-header">
      <div>
        <h1 style="font-size:24px;">{isLoggedIn ? "Your Shares" : "Your Guest Share"}</h1>
        <p style="color:var(--color-text-muted); font-size:13px; margin-top:2px;">
          {isLoggedIn ? "Manage and monitor your active and past shares." : "Guests keep one share at a time. Delete it or create a new one to replace it."}
        </p>
      </div>
      <a href="/" class="btn btn-primary">
        <svg class="icon-svg" viewBox="0 0 24 24">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        New Share
      </a>
    </div>

    {message && (
      <div class="banner banner-warning" style="margin-bottom:var(--space-4);">
        <svg class="icon-svg" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="m9 12 2 2 4-4"></path>
        </svg>
        <div>{message}</div>
      </div>
    )}

    <div class="dashboard-table-wrapper">
      {shares.length === 0 ? (
        <div style="padding:var(--space-8); text-align:center; color:var(--color-text-muted);">
          <p>You haven't created any shares yet.</p>
          <a href="/" class="btn btn-secondary" style="margin-top:var(--space-4);">Create Share</a>
        </div>
      ) : (
        <table class="dashboard-table">
          <thead>
            <tr>
              <th>Link Slug</th>
              <th>Type</th>
              <th>Expires At</th>
              <th>Status</th>
              <th>Security</th>
              <th style="text-align:right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            {shares.map((share) => (
              <tr>
                <td class="share-link-cell">
                  <a href={share.url} target="_blank" style="font-weight:600;">/{share.slug}</a>
                </td>
                <td style="text-transform:capitalize;">
                  {share.type}
                </td>
                <td>
                  {share.expiry}
                </td>
                <td>
                  {share.isExpired ? (
                    <span style="color:var(--color-danger); font-weight:500;">Expired</span>
                  ) : (
                    <span style="color:green; font-weight:500;">Active</span>
                  )}
                </td>
                <td>
                  {share.passwordProtected ? "🔒 Password" : "🔓 Public"}
                </td>
                <td style="text-align:right;">
                  <div style="display:inline-flex; gap:var(--space-2); justify-content:flex-end;">
                    <!-- Copy Link -->
                    <button 
                      class="btn btn-secondary btn-icon copy-dash-btn" 
                      data-url={share.url} 
                      title="Copy URL"
                      aria-label="Copy link URL"
                    >
                      <svg class="icon-svg" viewBox="0 0 24 24">
                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                      </svg>
                    </button>

                    <!-- Delete Link -->
                    <form method="POST" style="margin:0;">
                      <input type="hidden" name="action" value="delete" />
                      <input type="hidden" name="slug" value={share.slug} />
                      <button 
                        type="submit" 
                        class="btn btn-danger btn-icon" 
                        title="Delete early"
                        aria-label="Delete share"
                        onclick="return confirm('Are you sure you want to permanently delete this share early?');"
                      >
                        <svg class="icon-svg" viewBox="0 0 24 24">
                          <polyline points="3 6 5 6 21 6"></polyline>
                          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                          <line x1="10" y1="11" x2="10" y2="17"></line>
                          <line x1="14" y1="11" x2="14" y2="17"></line>
                        </svg>
                      </button>
                    </form>
                  </div>
                  </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  </div>

  <!-- Dash Interaction Script -->
  <script>
    const copyBtns = document.querySelectorAll(".copy-dash-btn");
    copyBtns.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const url = btn.getAttribute("data-url");
        if (url) {
          try {
            await navigator.clipboard.writeText(url);
            const originalHtml = btn.innerHTML;
            btn.innerHTML = `<svg class="icon-svg" viewBox="0 0 24 24" style="color:green;"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
            setTimeout(() => {
              btn.innerHTML = originalHtml;
            }, 2000);
          } catch (err) {
            console.error("Copy failed", err);
          }
        }
      });
    });
  </script>
</Layout>
