---
import Layout from '../layouts/Layout.astro';

// Check auth
const isLoggedIn = Astro.cookies.has("session");
if (!isLoggedIn) {
  return Astro.redirect('/login');
}

// Access store
if (!globalThis.textSharesStore) {
  globalThis.textSharesStore = new Map();
}
const store = globalThis.textSharesStore as Map<string, any>;

// Add dummy data for visualization if empty
if (store.size === 0) {
  store.set("demo-code", {
    contentType: "text",
    textContent: `// TextShare Demo Snippet\nimport { defineConfig } from 'astro/config';`,
    expiryDate: new Date(Date.now() + 1000 * 60 * 60 * 24),
    language: "javascript",
    password: null,
  });
  store.set("image", {
    contentType: "image",
    textContent: "",
    imageSrc: "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=600&auto=format&fit=crop",
    expiryDate: new Date(Date.now() + 1000 * 60 * 60 * 48),
    language: "plaintext",
    password: null,
  });
  store.set("expired-demo", {
    contentType: "text",
    textContent: "Old expired text.",
    expiryDate: new Date(Date.now() - 1000 * 60 * 60),
    language: "plaintext",
    password: null,
  });
}

// Handle share deletion
let message = "";
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get("action")?.toString();
    const deleteSlug = formData.get("slug")?.toString();

    if (action === "delete" && deleteSlug) {
      if (store.has(deleteSlug)) {
        store.delete(deleteSlug);
        message = `Successfully deleted share /${deleteSlug}.`;
      }
    }
  } catch (err) {
    message = "An error occurred while deleting.";
  }
}

// Fetch current shares
const shares = Array.from(store.entries()).map(([slug, data]) => {
  const isExpired = new Date() > new Date(data.expiryDate);
  return {
    slug,
    type: data.contentType,
    expiry: new Date(data.expiryDate).toLocaleString(),
    isExpired,
    passwordProtected: !!data.password,
    url: `${Astro.url.origin}/${slug}`
  };
});
---

<Layout title="Dashboard — TextShare">
  <div class="dashboard-container">
    <div class="dashboard-header">
      <div>
        <h1 style="font-size:24px;">Your Shares</h1>
        <p style="color:var(--color-text-muted); font-size:13px; margin-top:2px;">Manage and monitor your active and past shares.</p>
      </div>
      <a href="/" class="btn btn-primary">
        <svg class="icon-svg" viewBox="0 0 24 24">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        New Share
      </a>
    </div>

    {message && (
      <div class="banner banner-warning" style="margin-bottom:var(--space-4);">
        <svg class="icon-svg" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="m9 12 2 2 4-4"></path>
        </svg>
        <div>{message}</div>
      </div>
    )}

    <div class="dashboard-table-wrapper">
      {shares.length === 0 ? (
        <div style="padding:var(--space-8); text-align:center; color:var(--color-text-muted);">
          <p>You haven't created any shares yet.</p>
          <a href="/" class="btn btn-secondary" style="margin-top:var(--space-4);">Create Share</a>
        </div>
      ) : (
        <table class="dashboard-table">
          <thead>
            <tr>
              <th>Link Slug</th>
              <th>Type</th>
              <th>Expires At</th>
              <th>Status</th>
              <th>Security</th>
              <th style="text-align:right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            {shares.map((share) => (
              <tr>
                <td class="share-link-cell">
                  <a href={share.url} target="_blank" style="font-weight:600;">/{share.slug}</a>
                </td>
                <td style="text-transform:capitalize;">
                  {share.type}
                </td>
                <td>
                  {share.expiry}
                </td>
                <td>
                  {share.isExpired ? (
                    <span style="color:var(--color-danger); font-weight:500;">Expired</span>
                  ) : (
                    <span style="color:green; font-weight:500;">Active</span>
                  )}
                </td>
                <td>
                  {share.passwordProtected ? "🔒 Password" : "🔓 Public"}
                </td>
                <td style="text-align:right;">
                  <div style="display:inline-flex; gap:var(--space-2); justify-content:flex-end;">
                    <!-- Copy Link -->
                    <button 
                      class="btn btn-secondary btn-icon copy-dash-btn" 
                      data-url={share.url} 
                      title="Copy URL"
                      aria-label="Copy link URL"
                    >
                      <svg class="icon-svg" viewBox="0 0 24 24">
                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                      </svg>
                    </button>

                    <!-- Delete Link -->
                    <form method="POST" style="margin:0;">
                      <input type="hidden" name="action" value="delete" />
                      <input type="hidden" name="slug" value={share.slug} />
                      <button 
                        type="submit" 
                        class="btn btn-danger btn-icon" 
                        title="Delete early"
                        aria-label="Delete share"
                        onclick="return confirm('Are you sure you want to permanently delete this share early?');"
                      >
                        <svg class="icon-svg" viewBox="0 0 24 24">
                          <polyline points="3 6 5 6 21 6"></polyline>
                          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                          <line x1="10" y1="11" x2="10" y2="17"></line>
                          <line x1="14" y1="11" x2="14" y2="17"></line>
                        </svg>
                      </button>
                    </form>
                  </div>
                  </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  </div>

  <!-- Dash Interaction Script -->
  <script>
    const copyBtns = document.querySelectorAll(".copy-dash-btn");
    copyBtns.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const url = btn.getAttribute("data-url");
        if (url) {
          try {
            await navigator.clipboard.writeText(url);
            const originalHtml = btn.innerHTML;
            btn.innerHTML = `<svg class="icon-svg" viewBox="0 0 24 24" style="color:green;"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
            setTimeout(() => {
              btn.innerHTML = originalHtml;
            }, 2000);
          } catch (err) {
            console.error("Copy failed", err);
          }
        }
      });
    });
  </script>
</Layout>
