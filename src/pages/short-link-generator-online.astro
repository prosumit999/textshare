---
import Layout from '../layouts/Layout.astro';
import { getCurrentUser } from '../lib/auth';
import { checkRateLimit, getClientIp, rateLimitResponse, secureCookieOptions } from '../lib/security';
import { getShare, saveShare } from '../lib/share-store';
import QRCode from 'qrcode';

const user = await getCurrentUser(Astro.cookies);
const isLoggedIn = !!user;
const clientIp = getClientIp(Astro.request);

const guestShortlinkSlug = Astro.cookies.get("guest_shortlink_active")?.value;
const existingGuestLink = !isLoggedIn && guestShortlinkSlug ? await getShare(guestShortlinkSlug) : null;
const isGuestLimitReached = !isLoggedIn && !!existingGuestLink;

let createdShortUrl = "";
let createdSlug = "";
let qrDataUrl = "";
let errorMessage = "";
let successMessage = "";

if (Astro.request.method === "POST") {
  const rateLimit = await checkRateLimit('share:create', isLoggedIn ? user.email : clientIp, 20, 10 * 60);
  if (!rateLimit.allowed) {
    return rateLimitResponse(rateLimit.retryAfter, "Too many creation requests. Please wait a moment.");
  }

  const formData = await Astro.request.formData();
  const rawUrl = formData.get("destinationUrl")?.toString().trim() || "";
  const customSlug = formData.get("customSlug")?.toString().trim().toLowerCase() || "";
  const expiryChoice = formData.get("expiry")?.toString() || "7d";

  // Guest Limit Enforcement: 1 short link max
  if (!isLoggedIn && isGuestLimitReached) {
    errorMessage = "Guest limit reached (1 active short link). Sign In to create unlimited short links with analytics!";
  } else if (!rawUrl) {
    errorMessage = "Please enter a valid destination URL.";
  } else {
    let targetUrl = rawUrl;
    if (!/^https?:\/\//i.test(targetUrl)) {
      targetUrl = "https://" + targetUrl;
    }

    try {
      new URL(targetUrl);
    } catch {
      errorMessage = "Invalid URL format. Please include a valid web address (e.g. https://example.com).";
    }

    if (!errorMessage) {
      let slug = customSlug.replace(/[^a-z0-9-_]/g, "");
      if (!slug) {
        slug = "s-" + Math.random().toString(36).substring(2, 8);
      }

      // Check slug availability
      const existing = await getShare(slug);
      if (existing) {
        errorMessage = `The short alias "/${slug}" is already taken. Please try another custom slug.`;
      } else {
        let expiryMs = 7 * 24 * 60 * 60 * 1000; // default 7 days
        if (expiryChoice === "24h") expiryMs = 24 * 60 * 60 * 1000;
        if (expiryChoice === "30d") expiryMs = 30 * 24 * 60 * 60 * 1000;
        if (expiryChoice === "never" && isLoggedIn) expiryMs = 365 * 10 * 24 * 60 * 60 * 1000;

        const expiryDate = new Date(Date.now() + expiryMs);

        await saveShare(slug, {
          contentType: "url",
          textContent: targetUrl,
          imageSrc: null,
          expiryDate,
          burnAfterReading: false,
          language: "plaintext",
          passwordHash: null,
          owner: isLoggedIn ? user.email : null,
          guestIp: isLoggedIn ? null : clientIp,
          sizeBytes: targetUrl.length,
          createdAt: new Date(),
          viewCount: 0,
          analyticsEnabled: true
        });

        if (!isLoggedIn) {
          Astro.cookies.set("guest_shortlink_active", slug, secureCookieOptions(60 * 60 * 24 * 365));
        }

        createdSlug = slug;
        createdShortUrl = `${Astro.url.origin}/${slug}`;
        qrDataUrl = await QRCode.toDataURL(createdShortUrl, { width: 200, margin: 1 });
        successMessage = `Your short link /${slug} has been generated successfully!`;
      }
    }
  }
}
---

<Layout title="Online Short Link Generator — TextShare" description="Shorten long URLs instantly with TextShare's fast, free online link shortener with click and device analytics.">
  <div class="creator-container" style=" padding-bottom: var(--space-12);">
    <!-- Copy Notification Toast -->
    <div id="copy-notification" class="copy-notification" role="status" aria-live="polite" aria-atomic="true"></div>

    <!-- Hero Section -->
    <div class="hero-section">
      <span class="eyebrow">FAST & TRACKABLE URL SHORTENER</span>
      <h1>Online Short Link Generator</h1>
      <p>Transform long URLs into memorable short links with instant 302 redirection, click tracking, and device analytics.</p>
    </div>

    <!-- Error Banner -->
    {errorMessage && (
      <div class="banner banner-warning" style="margin-bottom: 24px; background-color: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.25); color: var(--color-danger); border-radius: 14px; padding: 14px 18px; font-size: 13px; font-weight: 600;">
        <svg class="icon-svg" viewBox="0 0 24 24" style="width: 18px; height: 18px; margin-right: 8px; vertical-align: middle;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        {errorMessage}
      </div>
    )}

    <!-- Guest Limit Indicator Banner -->
    {!isLoggedIn && (
      <div class="banner banner-warning" style="display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 24px; padding: 14px 18px; border-radius: 14px; background: color-mix(in srgb, var(--color-accent) 8%, var(--color-bg-surface)); border: 1px solid color-mix(in srgb, var(--color-accent) 25%, var(--color-border));">
        <div style="display: flex; align-items: center; gap: 10px;">
          <svg class="icon-svg" viewBox="0 0 24 24" style="width: 18px; height: 18px; color: var(--color-accent); flex-shrink: 0;"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
          <span style="font-size: 13px; color: var(--color-text-base);">
            Guests get <strong>1 active short link</strong>. {isGuestLimitReached ? 'Guest link limit reached.' : '1 slot remaining.'}
          </span>
        </div>
        <a href="/login" class="btn btn-secondary btn-sm" style="font-size: 12px; white-space: nowrap; font-weight: 650;">
          Sign In for Unlimited
        </a>
      </div>
    )}

    <!-- Generator Panel -->
    <div class="profile-panel" style="margin-bottom: 32px;">
      <div class="profile-panel-heading" style="border-bottom: 1px solid var(--color-border); padding-bottom: 14px; margin-bottom: 20px;">
        <div>
          <span class="profile-section-kicker">URL SHORTENER TOOL</span>
          <h2 style="font-size: 18px; text-align: left; margin: 2px 0 0;">Create a Short Link</h2>
        </div>
      </div>

      <form method="POST" action="/short-link-generator-online">
        <!-- Destination URL Input -->
        <div class="tool-field" style="margin-bottom: 20px;">
          <label for="destinationUrl" style="font-size: 13px; font-weight: 700; color: var(--color-text-base);">
            Destination Long URL *
          </label>
          <div style="position: relative;">
            <input 
              type="url" 
              id="destinationUrl" 
              name="destinationUrl" 
              class="tool-input" 
              placeholder="https://example.com/very-long-web-page-path-or-article" 
              required 
              disabled={!isLoggedIn && isGuestLimitReached}
              style="padding-left: 42px; font-size: 14px; height: 46px;"
            />
            <svg class="icon-svg" viewBox="0 0 24 24" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px; color: var(--color-text-muted); pointer-events: none;">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </div>
        </div>

        <!-- Custom Slug & Expiration Options Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-bottom: 24px;">
          <div class="tool-field">
            <label for="customSlug" style="font-size: 12px; font-weight: 650; color: var(--color-text-base);">
              Custom Short Alias (Optional)
            </label>
            <div style="display: flex; align-items: center; gap: 0; border: 1px solid var(--color-border); border-radius: 10px; overflow: hidden; background: var(--color-bg-input);">
              <span style="padding: 0 12px; font-size: 12px; color: var(--color-text-muted); font-weight: 600; background: color-mix(in srgb, var(--color-bg-base) 80%, var(--color-bg-surface)); border-right: 1px solid var(--color-border); height: 42px; display: flex; align-items: center;">
                {Astro.url.host}/
              </span>
              <input 
                type="text" 
                id="customSlug" 
                name="customSlug" 
                class="tool-input" 
                placeholder="my-alias" 
                pattern="[a-zA-Z0-9-_]+"
                disabled={!isLoggedIn && isGuestLimitReached}
                style="border: none; border-radius: 0; height: 42px; font-size: 13px;"
              />
            </div>
          </div>

          <div class="tool-field">
            <label for="expiry" style="font-size: 12px; font-weight: 650; color: var(--color-text-base);">Link Expiration</label>
            <select id="expiry" name="expiry" class="tool-select" disabled={!isLoggedIn && isGuestLimitReached} style="height: 42px; font-size: 13px;">
              <option value="7d">7 Days Expiry</option>
              <option value="24h">24 Hours Expiry</option>
              <option value="30d">30 Days Expiry</option>
              {isLoggedIn && <option value="never">Never (Pro Account Perk)</option>}
            </select>
          </div>
        </div>

        <div style="display: flex; justify-content: flex-end; align-items: center;">
          <button 
            type="submit" 
            class="btn btn-primary" 
            style="width: 100%; padding: 12px 28px; font-size: 14px; font-weight: 700; border-radius: 10px;"
            disabled={!isLoggedIn && isGuestLimitReached}
          >
            <svg class="icon-svg" viewBox="0 0 24 24" aria-hidden="true" style="width: 16px; height: 16px; margin-right: 8px;">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
            Generate Short Link
          </button>
        </div>
      </form>
    </div>

    <!-- Result Card -->
    {createdShortUrl && (
      <div class="result-card" style="margin-bottom: 32px; border-color: var(--color-accent);">
        <div class="result-header">
          <h2 style="margin: 0; color: var(--color-accent); font-size: 20px;">Short Link Created Successfully!</h2>
          <p style="color: var(--color-text-muted); font-size: 13px; margin-top: var(--space-2);">Your short URL is live with instant redirection and view analytics.</p>
        </div>

        <div class="result-body">
          <div class="result-info">
            <div class="input-label-pair">
              <label style="font-size: 12px; font-weight: 700; color: var(--color-text-base);">Your Short URL</label>
              <div class="url-copy-box">
                <div class="url-text" id="created-url-text" style="color: var(--color-accent); font-weight: 700;">{createdShortUrl}</div>
                <button id="copy-url-btn" class="btn btn-primary" data-url={createdShortUrl} title="Copy short link">
                  <svg class="icon-svg" viewBox="0 0 24 24" style="width: 15px; height: 15px; margin-right: 4px;">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span>Copy</span>
                </button>
              </div>
            </div>

            <div style="font-size: 12px; color: var(--color-text-muted); display: flex; align-items: center; gap: 6px;">
              <svg class="icon-svg" viewBox="0 0 24 24" style="width: 14px; height: 14px; color: var(--color-accent); flex-shrink: 0;"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              <span>Redirects instantly to destination • Clicks, locations & devices tracked in real-time.</span>
            </div>

            <div style="margin-top: var(--space-3); display: flex; gap: 10px; flex-wrap: wrap;">
              {isLoggedIn ? (
                <a href="/profile#shortlinks" class="btn btn-secondary btn-sm" style="font-size: 12px; padding: 8px 16px;">
                  View Analytics in Workspace →
                </a>
              ) : (
                <a href="/login" class="btn btn-secondary btn-sm" style="font-size: 12px; padding: 8px 16px;">
                  Sign In to Save & Track Links →
                </a>
              )}
              <a href="/short-link-generator-online" class="btn btn-secondary btn-sm" style="font-size: 12px; padding: 8px 16px;">
                Create Another Link
              </a>
            </div>
          </div>

          <div class="qr-code-section" style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
            <div class="qr-container" style="padding: 12px; background: #ffffff; border-radius: 14px; border: 1px solid var(--color-border); box-shadow: 0 8px 20px rgba(0,0,0,0.06);">
              <img src={qrDataUrl} alt="Short Link QR Code" width="150" height="150" style="display: block; margin: 0 auto; aspect-ratio: 1/1;" />
            </div>
            <a href={qrDataUrl} download={`qr-${createdSlug}.png`} class="btn btn-secondary btn-sm" style="font-size: 11px; margin-top: 10px; padding: 5px 12px;">
              <svg class="icon-svg" viewBox="0 0 24 24" style="width: 13px; height: 13px; margin-right: 4px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
              Download QR Code
            </a>
          </div>
        </div>
      </div>
    )}

    <!-- Features Launchpad Grid -->
    <section class="profile-panel" style="margin-top: 36px;">
      <div class="profile-panel-heading" style="border-bottom: 1px solid var(--color-border); padding-bottom: 14px; margin-bottom: 20px;">
        <div>
          <span class="profile-section-kicker">BUILT-IN FEATURES</span>
          <h2 style="font-size: 18px; text-align: left; margin: 2px 0 0;">Why Use TextShare Link Shortener?</h2>
        </div>
      </div>

      <div class="tools-launchpad" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));">
        <div class="tool-card" style="cursor: default;">
          <div class="tool-card-icon">
            <svg viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          </div>
          <h3>302 Instant Redirection</h3>
          <p>Fast edge 302 redirects deliver visitors directly to the destination without interstitial delay pages.</p>
        </div>

        <div class="tool-card" style="cursor: default;">
          <div class="tool-card-icon">
            <svg viewBox="0 0 24 24"><path d="M18 20V10"></path><path d="M12 20V4"></path><path d="M6 20v-6"></path></svg>
          </div>
          <h3>Real-Time Analytics</h3>
          <p>Track total clicks, unique IP visitors, country distribution, and device types (mobile/desktop/tablet).</p>
        </div>

        <div class="tool-card" style="cursor: default;">
          <div class="tool-card-icon">
            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect><path d="M14 14h3v3h-3z"></path></svg>
          </div>
          <h3>Instant QR Studio</h3>
          <p>Every short link comes with an auto-generated QR code ready for download and print/digital sharing.</p>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  const copyBtn = document.getElementById("copy-url-btn");
  const notificationToast = document.getElementById("copy-notification");

  const showCopyToast = (message: string) => {
    if (!notificationToast) return;
    notificationToast.textContent = message;
    notificationToast.classList.add("is-visible");
    setTimeout(() => notificationToast.classList.remove("is-visible"), 2600);
  };

  copyBtn?.addEventListener("click", async () => {
    const url = copyBtn.getAttribute("data-url");
    if (!url) return;
    try {
      await navigator.clipboard.writeText(url);
      showCopyToast("Short link copied to clipboard!");
    } catch (err) {
      console.error("Failed to copy URL", err);
    }
  });
</script>
