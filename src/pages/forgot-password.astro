---
import Layout from '../layouts/Layout.astro';
import { issuePasswordReset } from '../lib/account-tokens';
import { normalizeEmail } from '../lib/auth';
import { checkRateLimit, getClientIp, logSecurityEvent, rateLimitResponse } from '../lib/security';

let sent = false;
if (Astro.request.method === 'POST') {
  const ip = getClientIp(Astro.request);
  const limit = await checkRateLimit('auth:password-reset-request', ip, 5, 60 * 60);
  if (!limit.allowed) return rateLimitResponse(limit.retryAfter);
  const form = await Astro.request.formData();
  const email = normalizeEmail(form.get('email')?.toString() || '');
  if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    const accountLimit = await checkRateLimit('auth:password-reset-email', email, 3, 60 * 60);
    if (!accountLimit.allowed) return rateLimitResponse(accountLimit.retryAfter);
    try { await issuePasswordReset(email, Astro.url.origin); }
    catch { await logSecurityEvent('password_reset_email_failed', Astro.request); }
  }
  sent = true;
  await logSecurityEvent('password_reset_requested', Astro.request);
}
---

<Layout title="Forgot Password — TextShare" description="Request a secure TextShare password reset link.">
  <div class="auth-card">
    <h2>Reset your password</h2>
    <p class="subtitle">We’ll email a single-use reset link that expires in 30 minutes.</p>
    {sent && <div class="banner banner-success" role="status">If an eligible account exists for that address, a reset link has been sent.</div>}
    {!sent && <form method="POST" class="auth-form">
      <div class="input-label-pair"><label for="reset-email">Email address</label><input id="reset-email" class="text-input" type="email" name="email" maxlength="254" required autofocus autocomplete="email" /></div>
      <button class="btn btn-primary auth-submit" type="submit">Send reset link</button>
    </form>}
    <div class="auth-footer"><a href="/login">Back to sign in</a></div>
  </div>
</Layout>
