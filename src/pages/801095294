---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { recordAudit } from '../../lib/admin';
import { getCurrentUser, hasRecentAdminStepUp } from '../../lib/auth';
import {
  deleteHomeHeroSection,
  getHomeHeroSection,
  listHomeHeroSections,
  saveHomeHeroSection,
} from '../../lib/home-hero-store';
import { sanitizeBlogHtml } from '../../lib/blog-content';
import { deleteBlogImageFromUrl } from '../../lib/blog-images';

const admin = (await getCurrentUser(Astro.cookies))!;
let message = '';
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action')?.toString();
  const id = form.get('id')?.toString();
  if (action === 'delete' && id) {
    if (!(await hasRecentAdminStepUp(Astro.cookies)))
      return Astro.redirect('/login?stepup=1');
    const section = await getHomeHeroSection(id);
    if (section && (await deleteHomeHeroSection(id))) {
      await deleteBlogImageFromUrl(section.coverImage);
      await recordAudit({
        actor: admin.email,
        action: 'delete',
        resourceType: 'home_hero_section',
        resourceId: id,
        details: section.title,
      });
      message = 'Section deleted.';
    }
  } else if (action === 'save') {
    if (!(await hasRecentAdminStepUp(Astro.cookies)))
      return Astro.redirect('/login?stepup=1');
    const title = form.get('title')?.toString().trim() || '';
    const rawContent = form.get('content')?.toString() || '';
    const content = sanitizeBlogHtml(rawContent);
    const coverImage = form.get('coverImage')?.toString().trim() || '';
    const validCoverImage =
      !coverImage ||
      coverImage.startsWith('https://') ||
      /^\/api\/blog-images\/[a-f0-9]{24}$/.test(coverImage);
    const enabled = form.get('enabled') === 'on';
    const sortOrder = Math.max(0, Number(form.get('sortOrder')) || 0);
    if (title.length < 3 || title.length > 160 || !content.trim() || rawContent.length > 200000 || !validCoverImage)
      error = 'Check the title, content length, and cover image.';
    else {
      const previousCoverImage = id ? (await getHomeHeroSection(id))?.coverImage : '';
      const section = await saveHomeHeroSection({
        id,
        title,
        content,
        coverImage,
        enabled,
        sortOrder,
      });
      if (previousCoverImage && previousCoverImage !== coverImage)
        await deleteBlogImageFromUrl(previousCoverImage);
      await recordAudit({
        actor: admin.email,
        action: id ? 'update' : 'create',
        resourceType: 'home_hero_section',
        resourceId: section.id,
        details: `${section.title} (${enabled ? 'enabled' : 'disabled'})`,
      });
      message = 'Section saved.';
    }
  }
}

const sections = await listHomeHeroSections();
const editSection = Astro.url.searchParams.get('edit')
  ? await getHomeHeroSection(Astro.url.searchParams.get('edit')!)
  : null;
const previewSection = Astro.url.searchParams.get('preview')
  ? await getHomeHeroSection(Astro.url.searchParams.get('preview')!)
  : null;
const previewHtml = previewSection ? sanitizeBlogHtml(previewSection.content) : '';
const showEditor =
  Astro.url.searchParams.get('view') === 'create' ||
  Astro.url.searchParams.has('edit') ||
  Astro.url.searchParams.has('preview');
---

<AdminLayout title={showEditor ? (editSection ? 'Edit section' : previewSection ? 'Preview section' : 'Create section') : 'Home Hero Sections'}>
  {message && <div class="admin-alert success">{message}</div>}
  {error && <div class="admin-alert danger">{error}</div>}
  <div class="admin-blog-stack">
    {!showEditor ? (
      <section class="admin-panel">
        <div class="admin-panel-heading">
          <div>
            <h2>Home Hero Sections</h2>
            <p>{sections.length} sections · rendered on the homepage in the SEO block</p>
          </div>
          <a href="/8010952940-admin/home-hero?view=create" class="btn btn-primary">New section</a>
        </div>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Section</th>
                <th>Status</th>
                <th>Order</th>
                <th>Updated</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {sections.map((section) => (
                <tr>
                  <td>
                    <div class="admin-post-cell">
                      {section.coverImage ? (
                        <img src={section.coverImage} alt="" />
                      ) : (
                        <span class="admin-post-placeholder">Aa</span>
                      )}
                      <div>
                        <strong>{section.title}</strong>
                        <small>{section.id.slice(0, 8)}</small>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class:list={['admin-tag', section.enabled ? 'published' : 'draft']}>
                      {section.enabled ? 'Enabled' : 'Disabled'}
                    </span>
                  </td>
                  <td>{section.sortOrder}</td>
                  <td>{section.updatedAt.toLocaleDateString()}</td>
                  <td>
                    <div class="admin-row-actions">
                      <a href={`/8010952940-admin/home-hero?view=create&edit=${section.id}`}>Edit</a>
                      <a href={`/8010952940-admin/home-hero?view=create&preview=${section.id}`}>Preview</a>
                      <form method="POST" onsubmit="return confirm('Delete this home hero section permanently?')">
                        <input type="hidden" name="action" value="delete" />
                        <input type="hidden" name="id" value={section.id} />
                        <button class="danger-link">Delete</button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))}
              {sections.length === 0 && (
                <tr>
                  <td colspan="5" class="admin-empty">No home hero sections found.</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </section>
    ) : (
      <section class:list={['admin-editor-workspace', { 'is-preview': previewSection }]} id="hero-editor">
        {previewSection ? (
          <section class="admin-panel admin-editor-panel">
            <div class="admin-panel-heading">
              <div>
                <h2>Section preview</h2>
                <p>{previewSection.enabled ? 'Enabled' : 'Disabled'} · order {previewSection.sortOrder}</p>
              </div>
              <a href="/8010952940-admin/home-hero">Back to all sections</a>
            </div>
            {previewSection.coverImage && (
              <img class="admin-cover-preview" src={previewSection.coverImage} alt="" />
            )}
            <h1 class="admin-preview-title">{previewSection.title}</h1>
            <div class="admin-rich-preview" set:html={previewHtml}></div>
          </section>
        ) : (
          <>
            <div class="blog-editor-heading">
              <p>
                {editSection
                  ? `Last updated ${editSection.updatedAt.toLocaleString()}`
                  : 'Create a rich content section for the homepage.'}
              </p>
              <a href="/8010952940-admin/home-hero" class="btn btn-secondary">Back to sections</a>
            </div>
            <form method="POST" class="admin-panel admin-editor-form rich-post-form">
              <input type="hidden" name="action" value="save" />
              <input type="hidden" name="id" value={editSection?.id || ''} />
              <div class="admin-editor-grid">
                <label>
                  Title
                  <input class="text-input" name="title" maxlength="160" required value={editSection?.title || ''} />
                </label>
                <label>
                  Sort order
                  <input class="text-input" name="sortOrder" type="number" min="0" value={editSection?.sortOrder ?? 0} />
                </label>
              </div>
              <div class="editor-field-heading">
                <div>
                  <strong>Content</strong>
                  <small style="display: block; color: var(--color-text-muted); font-size: 11px; margin-top: 2px;">
                    Rich text · headings, images, lists, links, quotes, and code supported.
                  </small>
                </div>
              </div>
              <div class="rich-editor-shell">
                <div class="rich-editor-toolbar" role="toolbar" aria-label="Text formatting">
                  <button type="button" data-block="h2">H2</button>
                  <button type="button" data-block="h3">H3</button>
                  <button type="button" data-command="bold"><strong>B</strong></button>
                  <button type="button" data-command="italic"><em>I</em></button>
                  <button type="button" data-command="underline"><u>U</u></button>
                  <span></span>
                  <button type="button" data-command="insertUnorderedList">• List</button>
                  <button type="button" data-command="insertOrderedList">1. List</button>
                  <button type="button" data-block="blockquote">Quote</button>
                  <button type="button" data-block="pre">Code</button>
                  <span></span>
                  <button type="button" data-action="link">Link</button>
                  <button type="button" data-action="image-url">Image URL</button>
                  <button type="button" data-action="image-upload">Upload Image</button>
                  <button type="button" data-command="undo">Undo</button>
                </div>
                <div
                  id="rich-hero-editor"
                  class="rich-post-editor"
                  contenteditable="true"
                  role="textbox"
                  aria-multiline="true"
                  data-placeholder="Start writing the section content…"
                  set:html={editSection?.content || '<p></p>'}
                ></div>
                <textarea id="rich-hero-content" name="content" hidden>{editSection?.content || ''}</textarea>
              </div>
              <details class="featured-image-disclosure" open={Boolean(editSection?.coverImage)}>
                <summary>
                  <span>Cover image</span>
                  <small>Optional · shown at the top of the homepage section</small>
                </summary>
                <div class="featured-image-field">
                  <label>
                    Image URL
                    <input id="hero-cover-image-url" class="text-input" name="coverImage" type="text" readonly placeholder="No custom image selected" value={editSection?.coverImage || ''} />
                  </label>
                  <div class="featured-upload-row">
                    <input id="hero-cover-image-file" type="file" accept="image/png,image/jpeg,image/webp" />
                    <button id="upload-hero-cover-image" type="button" class="btn btn-secondary">Upload image</button>
                    <span id="hero-cover-status" aria-live="polite">Stored in MongoDB · PNG, JPG or WEBP · max 5 MB</span>
                  </div>
                  <img
                    id="hero-cover-image-preview"
                    class:list={['featured-image-preview', { visible: editSection?.coverImage }]}
                    src={editSection?.coverImage || ''}
                    alt="Cover image preview"
                  />
                </div>
              </details>
              <div class="admin-editor-footer">
                <label>
                  Status
                  <select class="select-input" name="enabled">
                    <option value="on" selected={editSection?.enabled !== false}>Enabled</option>
                    <option value="off" selected={editSection?.enabled === false}>Disabled</option>
                  </select>
                </label>
                <div class="editor-save-actions">
                  {editSection?.enabled && (
                    <a class="btn btn-secondary" href="/" target="_blank">View live page</a>
                  )}
                  <button class="btn btn-primary">Save section</button>
                </div>
              </div>
            </form>
          </>
        )}
      </section>
    )}
  </div>
</AdminLayout>

<script>
  const editor = document.querySelector<HTMLElement>('#rich-hero-editor');
  const content = document.querySelector<HTMLTextAreaElement>('#rich-hero-content');
  const form = document.querySelector<HTMLFormElement>('.rich-post-form');
  const imageFile = document.querySelector<HTMLInputElement>('#hero-cover-image-file');
  const imageUrl = document.querySelector<HTMLInputElement>('#hero-cover-image-url');
  const imagePreview = document.querySelector<HTMLImageElement>('#hero-cover-image-preview');
  const uploadButton = document.querySelector<HTMLButtonElement>('#upload-hero-cover-image');
  const uploadStatus = document.querySelector<HTMLElement>('#hero-cover-status');
  const focusEditor = () => editor?.focus();

  document.querySelectorAll<HTMLButtonElement>('.rich-editor-toolbar button').forEach((button) =>
    button.addEventListener('click', () => {
      focusEditor();
      const command = button.dataset.command;
      const block = button.dataset.block;
      const action = button.dataset.action;
      if (command) document.execCommand(command, false);
      if (block) document.execCommand('formatBlock', false, block);
      if (action === 'link') {
        const url = window.prompt('Paste the link URL');
        if (url) document.execCommand('createLink', false, url);
      }
      if (action === 'image-url') {
        const url = window.prompt('Paste an HTTPS image URL');
        if (url?.startsWith('https://')) document.execCommand('insertImage', false, url);
      }
      if (action === 'image-upload') {
        const fileInput = document.createElement('input');
        fileInput.type = 'file';
        fileInput.accept = 'image/png,image/jpeg,image/webp';
        fileInput.onchange = async () => {
          const file = fileInput.files?.[0];
          if (file) {
            const body = new FormData();
            body.set('image', file);
            try {
              const response = await fetch('/api/admin/blog-image', { method: 'POST', body });
              const result = await response.json();
              if (!response.ok) throw new Error(result.error || 'Upload failed.');
              document.execCommand('insertImage', false, result.url);
            } catch (err) {
              alert(err instanceof Error ? err.message : 'Upload failed.');
            }
          }
        };
        fileInput.click();
      }
    }),
  );

  form?.addEventListener('submit', () => {
    if (editor && content) content.value = editor.innerHTML;
  });

  imageUrl?.addEventListener('input', () => {
    if (imagePreview) {
      imagePreview.src = imageUrl.value;
      imagePreview.classList.toggle('visible', Boolean(imageUrl.value));
    }
  });

  uploadButton?.addEventListener('click', async () => {
    const file = imageFile?.files?.[0];
    if (!file || !imageUrl || !uploadStatus) {
      if (uploadStatus) uploadStatus.textContent = 'Choose an image first.';
      return;
    }
    uploadButton.disabled = true;
    uploadStatus.textContent = 'Uploading and optimizing…';
    const body = new FormData();
    body.set('image', file);
    try {
      const response = await fetch('/api/admin/blog-image', { method: 'POST', body });
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || 'Upload failed.');
      imageUrl.value = result.url;
      imageUrl.dispatchEvent(new Event('input'));
      uploadStatus.textContent = 'Upload complete.';
    } catch (error) {
      uploadStatus.textContent = error instanceof Error ? error.message : 'Upload failed.';
    } finally {
      uploadButton.disabled = false;
    }
  });
</script>