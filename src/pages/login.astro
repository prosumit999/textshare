---
import Layout from '../layouts/Layout.astro';
import AuthFrame from '../components/AuthFrame.astro';
import { destroySession, normalizeEmail, verifyCredentials } from '../lib/auth';
import { beginAdminVerification } from '../lib/admin-auth';
import { beginLoginVerification } from '../lib/login-otp';
import { checkRateLimit, getClientIp, logSecurityEvent, rateLimitResponse } from '../lib/security';
import { sendSecurityAlert } from '../lib/email';
import { serverEnv } from '../lib/env';

let error = "";
const success = Astro.url.searchParams.get('password') === 'changed' ? 'Password updated. Sign in with your new password.' : '';

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const email = formData.get("email")?.toString() || "";
    const password = formData.get("password")?.toString() || "";

    const user = email && password ? await verifyCredentials(email, password) : null;
    if (!user) {
      const ip = getClientIp(Astro.request);
      const limit = await checkRateLimit('auth:login-failed', `${ip}:${normalizeEmail(email)}`, 5, 15 * 60);
      await logSecurityEvent('login_failed', Astro.request, { emailHash: normalizeEmail(email).slice(0, 3) });
      if (normalizeEmail(email) === normalizeEmail(serverEnv.ADMIN_EMAIL || 'prosumit999@gmail.com') && limit.remaining <= 1)
        await sendSecurityAlert('Repeated owner sign-in failures', `Repeated failed owner sign-in attempts were detected from ${getClientIp(Astro.request)}.`).catch(() => false);
      if (!limit.allowed) return rateLimitResponse(limit.retryAfter, 'Too many failed sign-in attempts. Try again later.');
      error = "Invalid email or password.";
    } else {
      if (!user.emailVerified) {
        error = 'Verify your email address before signing in.';
      } else {
        const otpLimit = await checkRateLimit('auth:otp-send', `${getClientIp(Astro.request)}:${user.email}`, 5, 15 * 60);
        if (!otpLimit.allowed) return rateLimitResponse(otpLimit.retryAfter, 'Too many sign-in code requests. Try again later.');
        if (user.isAdmin) {
          try {
            await destroySession(Astro.cookies);
            await beginAdminVerification(Astro.cookies, user);
            return Astro.redirect('/admin-verify');
          } catch {
            await logSecurityEvent('admin_verification_email_failed', Astro.request);
            error = 'Admin verification email could not be sent. Check the mail configuration.';
          }
        } else {
          try {
            await destroySession(Astro.cookies);
            await beginLoginVerification(Astro.cookies, user);
            await logSecurityEvent('login_otp_sent', Astro.request);
            return Astro.redirect('/login-verify');
          } catch {
            await logSecurityEvent('login_otp_email_failed', Astro.request);
            error = 'Your sign-in code could not be sent. Check the mail configuration and try again.';
          }
        }
      }
    }
  } catch (err) {
    error = "An error occurred during sign in.";
  }
}
---

<Layout title="Sign In — TextShare">
  <AuthFrame eyebrow="Welcome back" title="Sign in to TextShare" subtitle="Enter your password first. We’ll email a single-use code before opening your account.">

    {error && (
      <div class="banner banner-warning" role="alert">
        {error}
      </div>
    )}
    {success && <div class="banner banner-success" role="status">{success}</div>}

    <form method="POST" class="auth-form">
      <div class="input-label-pair">
        <label for="email-input">Email address</label>
        <div class="auth-input-wrap"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg><input
          type="email" 
          name="email" 
          id="email-input" 
          class="text-input" 
          placeholder="name@example.com" 
          required 
          maxlength="128"
          autofocus
        /></div>
      </div>

      <div class="input-label-pair">
        <div class="auth-label-row">
          <label for="password-input">Password</label>
          <a href="/forgot-password">Forgot password?</a>
        </div>
        <div class="auth-input-wrap auth-password-wrap"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg><input
          type="password" 
          name="password" 
          id="password-input" 
          class="text-input" 
          placeholder="••••••••" 
          required 
        /><button type="button" class="auth-password-toggle" data-password-toggle data-target="password-input" aria-label="Show password" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6z"></path><circle cx="12" cy="12" r="2.5"></circle></svg></button></div>
      </div>

      <button type="submit" class="btn btn-primary auth-submit">
        Continue securely <span aria-hidden="true">→</span>
      </button>
    </form>

    <Fragment slot="footer"><p>New to TextShare? <a href="/signup">Create an account</a></p><p>Still waiting for verification? <a href="/verify-email">Resend the email</a></p></Fragment>
  </AuthFrame>
</Layout>
