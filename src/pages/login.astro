---
import Layout from '../layouts/Layout.astro';
import { createSession, destroySession, normalizeEmail, verifyCredentials } from '../lib/auth';
import { beginAdminVerification } from '../lib/admin-auth';
import { checkRateLimit, getClientIp, logSecurityEvent, rateLimitResponse } from '../lib/security';
import { sendSecurityAlert } from '../lib/email';
import { serverEnv } from '../lib/env';

let error = "";
const success = Astro.url.searchParams.get('password') === 'changed' ? 'Password updated. Sign in with your new password.' : '';

if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const email = formData.get("email")?.toString() || "";
    const password = formData.get("password")?.toString() || "";

    const user = email && password ? await verifyCredentials(email, password) : null;
    if (!user) {
      const ip = getClientIp(Astro.request);
      const limit = await checkRateLimit('auth:login-failed', `${ip}:${normalizeEmail(email)}`, 5, 15 * 60);
      await logSecurityEvent('login_failed', Astro.request, { emailHash: normalizeEmail(email).slice(0, 3) });
      if (normalizeEmail(email) === normalizeEmail(serverEnv.ADMIN_EMAIL || 'prosumit999@gmail.com') && limit.remaining <= 1)
        await sendSecurityAlert('Repeated owner sign-in failures', `Repeated failed owner sign-in attempts were detected from ${getClientIp(Astro.request)}.`).catch(() => false);
      if (!limit.allowed) return rateLimitResponse(limit.retryAfter, 'Too many failed sign-in attempts. Try again later.');
      error = "Invalid email or password.";
    } else {
      if (!user.emailVerified) {
        error = 'Verify your email address before signing in.';
      } else if (user.isAdmin) {
        try {
          await destroySession(Astro.cookies);
          await beginAdminVerification(Astro.cookies, user);
          return Astro.redirect('/admin-verify');
        } catch {
          await logSecurityEvent('admin_verification_email_failed', Astro.request);
          error = 'Admin verification email could not be sent. Check the mail configuration.';
        }
      } else {
        await createSession(Astro.cookies, user, { request: Astro.request });
        Astro.cookies.delete("guest_share_active", { path: "/" });
        return Astro.redirect('/');
      }
    }
  } catch (err) {
    error = "An error occurred during sign in.";
  }
}
---

<Layout title="Sign In — TextShare">
  <div class="auth-card">
    <h2>Welcome Back</h2>
    <p class="subtitle">Sign in to unlock password protection, vanity links, and image uploads.</p>

    {error && (
      <div class="banner banner-warning" style="background-color:rgba(239, 68, 68, 0.1); border-color:rgba(239, 68, 68, 0.2); color:var(--color-danger); margin-bottom:var(--space-4);">
        {error}
      </div>
    )}
    {success && <div class="banner banner-success" role="status">{success}</div>}

    <form method="POST" class="auth-form">
      <div class="input-label-pair">
        <label for="email-input">Email Address</label>
        <input
          type="email" 
          name="email" 
          id="email-input" 
          class="text-input" 
          placeholder="name@example.com" 
          required 
          maxlength="128"
          autofocus
        />
      </div>

      <div class="input-label-pair">
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <label for="password-input">Password</label>
          <a href="/forgot-password" style="font-size:12px; color:var(--color-text-muted);">Forgot password?</a>
        </div>
        <input 
          type="password" 
          name="password" 
          id="password-input" 
          class="text-input" 
          placeholder="••••••••" 
          required 
        />
      </div>

      <button type="submit" class="btn btn-primary" style="margin-top:var(--space-2); justify-content:center;">
        Sign In
      </button>
    </form>

    <div class="auth-footer">
      Don't have an account? <a href="/signup" style="font-weight:600;">Sign up</a>
      <br />Waiting for verification? <a href="/verify-email">Resend email</a>
    </div>
  </div>
</Layout>
