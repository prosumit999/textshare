---
import Layout from '../layouts/Layout.astro';
import { getCurrentUser } from '../lib/auth';

const user = await getCurrentUser(Astro.cookies);
---

<Layout
  title="Safe Link Inspector & Live Webpage Previewer — SSL Verification | TextShare"
  description="Inspect web links, verify SSL certificate security, and preview target web pages with real-time inspection on TextShare."
>
  <div class="safe-link-page container">
    <!-- Header Section -->
    <header class="tool-header">
      <div class="tool-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="badge-icon">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <path d="m9 12 2 2 4-4"></path>
        </svg>
        <span>SSL & LIVE WEBPAGE INSPECTOR</span>
      </div>
      <h1>Safe Link Inspector</h1>
      <p class="tool-subtitle">
        Enter or paste any link to inspect SSL security and preview destination webpage content before opening.
      </p>
    </header>

    <!-- Main Workspace -->
    <div class="inspector-workspace">
      <!-- Input & Search Control Card -->
      <div class="input-card">
        <label for="destinationUrl" class="input-label">
          <span>Enter Destination Webpage URL</span>
        </label>
        <div class="url-input-group">
          <div class="input-prefix-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
          </div>
          <input
            type="url"
            id="destinationUrl"
            class="url-input"
            placeholder="https://ahrefs.com"
            autocomplete="off"
            spellcheck="false"
          />
          <div class="input-actions">
            <button type="button" id="paste-btn" class="action-btn" title="Paste from Clipboard">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>
              <span>Paste</span>
            </button>
            <button type="button" id="clear-btn" class="action-btn text-danger hidden" title="Clear URL">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              <span>Clear</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Realtime SSL & Security Status Dashboard -->
      <div id="security-dashboard" class="security-dashboard">
        <div class="security-card">
          <div class="sec-icon-wrap" id="sec-icon-wrap">
            <svg id="sec-lock-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <div class="sec-info">
            <span class="sec-label">SSL Encryption Status</span>
            <strong id="sec-ssl-text" class="sec-status-text">Enter a URL to check SSL</strong>
          </div>
        </div>

        <div class="security-card">
          <div class="sec-icon-wrap info">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          </div>
          <div class="sec-info">
            <span class="sec-label">Target Domain</span>
            <strong id="sec-domain-text" class="sec-status-text">—</strong>
          </div>
        </div>

        <div class="security-card">
          <div class="sec-icon-wrap info">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          </div>
          <div class="sec-info">
            <span class="sec-label">HTTP Status Code</span>
            <strong id="sec-proto-text" class="sec-status-text">—</strong>
          </div>
        </div>

        <div class="security-card action-card">
          <a id="sec-open-link" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-primary open-btn disabled">
            <span>Open Safely</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        </div>
      </div>

      <!-- Live Webpage Iframe Browser Viewport -->
      <div class="browser-window">
        <!-- Window Chrome Top Bar -->
        <div class="browser-header">
          <div class="window-dots">
            <span class="dot dot-close"></span>
            <span class="dot dot-min"></span>
            <span class="dot dot-max"></span>
          </div>

          <div class="address-bar">
            <span id="browser-lock-icon" class="address-lock">🔒</span>
            <span id="browser-address-url" class="address-url">about:blank</span>
            <span id="browser-ssl-badge" class="address-badge">SSL Ready</span>
          </div>

          <div class="browser-tools">
            <div class="view-switcher">
              <button type="button" id="view-iframe-btn" class="switch-btn active" title="Interactive Iframe View">Frame</button>
              <button type="button" id="view-summary-btn" class="switch-btn" title="Server Webpage Summary">Summary</button>
            </div>
            <button type="button" id="reload-iframe-btn" class="tool-btn" title="Reload Frame">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
            </button>
            <a id="browser-open-ext" href="#" target="_blank" rel="noopener noreferrer" class="tool-btn" title="Open directly in new tab">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          </div>
        </div>

        <!-- Frame Viewport Area -->
        <div class="viewport-area">
          <div id="loading-spinner" class="viewport-loading hidden">
            <div class="spinner"></div>
            <span>Inspecting webpage & checking SSL security...</span>
          </div>

          <!-- Direct Iframe -->
          <iframe
            id="preview-iframe"
            src="about:blank"
            title="Live Webpage Interactive Preview"
            sandbox="allow-scripts allow-same-origin allow-forms allow-popups"
            loading="lazy"
          ></iframe>

          <!-- Webpage Summary & Inspection Fallback View -->
          <div id="summary-view" class="summary-view hidden">
            <div class="summary-card">
              <div class="summary-badge-header">
                <span class="summary-shield-badge" id="summary-shield-badge">🔒 HTTPS SSL Verified</span>
                <span class="summary-status-tag" id="summary-status-tag">HTTP 200 OK</span>
              </div>
              <h2 id="summary-page-title" class="summary-title">Webpage Title</h2>
              <p id="summary-page-desc" class="summary-desc">Webpage description will appear here after URL inspection.</p>

              <div class="summary-excerpt-box">
                <div class="excerpt-header">
                  <span>Page Content Excerpt</span>
                  <span id="summary-domain-badge" class="domain-tag">domain.com</span>
                </div>
                <p id="summary-excerpt-text" class="excerpt-text">Page text excerpt...</p>
              </div>

              <div id="summary-frame-warning" class="frame-warning-banner hidden">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span>Target domain sets <code>X-Frame-Options</code> restrictions preventing inline iframe embedding. Webpage text and SSL security verified above.</span>
              </div>

              <div class="summary-actions">
                <a id="summary-direct-btn" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-primary summary-open-btn">
                  <span>Open Destination Webpage Safely</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Features Section -->
    <section class="info-features-section">
      <h2>How Safe Link Inspector Works</h2>
      <div class="features-grid">
        <div class="feature-box">
          <div class="fbox-icon">🔒</div>
          <h3>Realtime SSL Verification</h3>
          <p>Checks whether the target URL uses valid HTTPS SSL encryption (Port 443) or unencrypted HTTP (Port 80) before you visit.</p>
        </div>
        <div class="feature-box">
          <div class="fbox-icon">🖼️</div>
          <h3>Live Interactive Iframe</h3>
          <p>Renders the target webpage inside a sandboxed frame so you can visually verify the content, layout, and domain structure.</p>
        </div>
        <div class="feature-box">
          <div class="fbox-icon">🛡️</div>
          <h3>Safe Navigation Shield</h3>
          <p>Protects you from unexpected redirects and suspicious scripts by keeping preview sessions isolated within your browser.</p>
        </div>
      </div>
    </section>
  </div>

  <script>
    const urlInput = document.getElementById('destinationUrl') as HTMLInputElement;
    const pasteBtn = document.getElementById('paste-btn');
    const clearBtn = document.getElementById('clear-btn');

    // Security Dashboard Elements
    const secSslText = document.getElementById('sec-ssl-text');
    const secDomainText = document.getElementById('sec-domain-text');
    const secProtoText = document.getElementById('sec-proto-text');
    const secOpenLink = document.getElementById('sec-open-link') as HTMLAnchorElement;
    const secIconWrap = document.getElementById('sec-icon-wrap');

    // Browser Header Elements
    const browserLockIcon = document.getElementById('browser-lock-icon');
    const browserAddressUrl = document.getElementById('browser-address-url');
    const browserSslBadge = document.getElementById('browser-ssl-badge');
    const browserOpenExt = document.getElementById('browser-open-ext') as HTMLAnchorElement;
    const reloadIframeBtn = document.getElementById('reload-iframe-btn');
    const viewIframeBtn = document.getElementById('view-iframe-btn');
    const viewSummaryBtn = document.getElementById('view-summary-btn');

    // Viewport Elements
    const iframe = document.getElementById('preview-iframe') as HTMLIFrameElement;
    const loadingSpinner = document.getElementById('loading-spinner');
    const summaryView = document.getElementById('summary-view');

    // Summary Elements
    const summaryShieldBadge = document.getElementById('summary-shield-badge');
    const summaryStatusTag = document.getElementById('summary-status-tag');
    const summaryPageTitle = document.getElementById('summary-page-title');
    const summaryPageDesc = document.getElementById('summary-page-desc');
    const summaryDomainBadge = document.getElementById('summary-domain-badge');
    const summaryExcerptText = document.getElementById('summary-excerpt-text');
    const summaryFrameWarning = document.getElementById('summary-frame-warning');
    const summaryDirectBtn = document.getElementById('summary-direct-btn') as HTMLAnchorElement;

    let debounceTimer: any = null;
    let activeMode: 'iframe' | 'summary' = 'iframe';

    function setViewMode(mode: 'iframe' | 'summary') {
      activeMode = mode;
      if (mode === 'iframe') {
        iframe?.classList.remove('hidden');
        summaryView?.classList.add('hidden');
        viewIframeBtn?.classList.add('active');
        viewSummaryBtn?.classList.remove('active');
      } else {
        iframe?.classList.add('hidden');
        summaryView?.classList.remove('hidden');
        viewSummaryBtn?.classList.add('active');
        viewIframeBtn?.classList.remove('active');
      }
    }

    if (viewIframeBtn) viewIframeBtn.addEventListener('click', () => setViewMode('iframe'));
    if (viewSummaryBtn) viewSummaryBtn.addEventListener('click', () => setViewMode('summary'));

    function resetInspector() {
      if (secSslText) secSslText.textContent = 'Enter a URL to check SSL';
      if (secDomainText) secDomainText.textContent = '—';
      if (secProtoText) secProtoText.textContent = '—';
      if (secIconWrap) secIconWrap.className = 'sec-icon-wrap';

      if (secOpenLink) {
        secOpenLink.href = '#';
        secOpenLink.classList.add('disabled');
      }

      if (browserAddressUrl) browserAddressUrl.textContent = 'about:blank';
      if (browserLockIcon) browserLockIcon.textContent = '🔒';
      if (browserSslBadge) {
        browserSslBadge.textContent = 'SSL Ready';
        browserSslBadge.className = 'address-badge';
      }
      if (browserOpenExt) browserOpenExt.href = '#';

      if (iframe) iframe.src = 'about:blank';
      if (loadingSpinner) loadingSpinner.classList.add('hidden');
      if (clearBtn) clearBtn.classList.add('hidden');
      setViewMode('iframe');
    }

    async function inspectUrl(rawVal: string) {
      const val = rawVal.trim();
      if (!val || val.length < 3) {
        resetInspector();
        return;
      }

      if (clearBtn) clearBtn.classList.remove('hidden');

      let fullUrl = val;
      if (!/^https?:\/\//i.test(fullUrl)) {
        fullUrl = 'https://' + fullUrl;
      }

      try {
        const parsed = new URL(fullUrl);
        const isHttps = parsed.protocol === 'https:';

        // Update Client-Side Security Dashboard
        if (secDomainText) secDomainText.textContent = parsed.hostname;
        if (secProtoText) secProtoText.textContent = isHttps ? 'HTTPS (Port 443)' : 'HTTP (Port 80)';

        if (secSslText && secIconWrap) {
          if (isHttps) {
            secSslText.textContent = 'HTTPS SSL Verified ✓ (Secure)';
            secIconWrap.className = 'sec-icon-wrap secure';
          } else {
            secSslText.textContent = 'HTTP Unencrypted ⚠️ (Insecure)';
            secIconWrap.className = 'sec-icon-wrap warning';
          }
        }

        if (secOpenLink) {
          secOpenLink.href = fullUrl;
          secOpenLink.classList.remove('disabled');
        }

        // Update Browser Window
        if (browserAddressUrl) browserAddressUrl.textContent = fullUrl;
        if (browserOpenExt) browserOpenExt.href = fullUrl;
        if (summaryDirectBtn) summaryDirectBtn.href = fullUrl;

        if (browserSslBadge && browserLockIcon) {
          if (isHttps) {
            browserLockIcon.textContent = '🔒';
            browserSslBadge.textContent = 'HTTPS SSL Verified ✓';
            browserSslBadge.className = 'address-badge secure';
          } else {
            browserLockIcon.textContent = '⚠️';
            browserSslBadge.textContent = 'HTTP Unencrypted';
            browserSslBadge.className = 'address-badge warning';
          }
        }

        // Show Spinner and attempt load
        if (loadingSpinner) loadingSpinner.classList.remove('hidden');
        if (iframe) iframe.src = fullUrl;

        // Fetch Server Inspection Analysis via /api/inspect-link
        const res = await fetch(`/api/inspect-link?url=${encodeURIComponent(fullUrl)}`);
        const data = await res.json();

        if (loadingSpinner) loadingSpinner.classList.add('hidden');

        if (data && data.success) {
          if (secProtoText) secProtoText.textContent = `HTTP ${data.status} ${data.statusText}`;

          if (summaryPageTitle) summaryPageTitle.textContent = data.title;
          if (summaryPageDesc) summaryPageDesc.textContent = data.description;
          if (summaryDomainBadge) summaryDomainBadge.textContent = data.domain;
          if (summaryExcerptText) summaryExcerptText.textContent = data.contentExcerpt;
          if (summaryStatusTag) summaryStatusTag.textContent = `HTTP ${data.status} ${data.statusText}`;

          if (summaryShieldBadge) {
            summaryShieldBadge.textContent = data.isHttps ? '🔒 HTTPS SSL Verified' : '⚠️ HTTP Unencrypted';
            summaryShieldBadge.className = data.isHttps ? 'summary-shield-badge secure' : 'summary-shield-badge warning';
          }

          if (!data.canFrame) {
            if (summaryFrameWarning) summaryFrameWarning.classList.remove('hidden');
            setViewMode('summary');
          } else {
            if (summaryFrameWarning) summaryFrameWarning.classList.add('hidden');
            if (activeMode === 'iframe') setViewMode('iframe');
          }
        } else {
          if (loadingSpinner) loadingSpinner.classList.add('hidden');
        }
      } catch (err) {
        if (loadingSpinner) loadingSpinner.classList.add('hidden');
      }
    }

    // Input Listener
    if (urlInput) {
      urlInput.addEventListener('input', () => {
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => inspectUrl(urlInput.value), 300);
      });

      if (urlInput.value.trim()) {
        inspectUrl(urlInput.value);
      }
    }

    // Clipboard Paste Button
    if (pasteBtn) {
      pasteBtn.addEventListener('click', async () => {
        try {
          const text = await navigator.clipboard.readText();
          if (text && urlInput) {
            urlInput.value = text;
            inspectUrl(text);
          }
        } catch (e) {
          urlInput?.focus();
        }
      });
    }

    // Clear Button
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        if (urlInput) {
          urlInput.value = '';
          urlInput.focus();
        }
        resetInspector();
      });
    }

    // Reload Button
    if (reloadIframeBtn && iframe) {
      reloadIframeBtn.addEventListener('click', () => {
        if (urlInput && urlInput.value.trim()) {
          inspectUrl(urlInput.value);
        }
      });
    }
  </script>

  <style>
    .safe-link-page {
      padding-top: 2rem;
      padding-bottom: 4rem;
      max-width: 1120px;
      margin: 0 auto;
    }

    .tool-header {
      text-align: center;
      margin-bottom: 2.5rem;
    }

    .tool-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: color-mix(in srgb, var(--color-accent) 12%, transparent);
      color: var(--color-accent);
      padding: 0.35rem 0.9rem;
      border-radius: 99px;
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      border: 1px solid color-mix(in srgb, var(--color-accent) 25%, transparent);
      margin-bottom: 1rem;
    }

    .badge-icon {
      width: 16px;
      height: 16px;
    }

    .tool-header h1 {
      font-size: 2.25rem;
      font-weight: 800;
      color: var(--color-text-base);
      letter-spacing: -0.02em;
      margin-bottom: 0.5rem;
    }

    .tool-subtitle {
      font-size: 1.05rem;
      color: var(--color-text-muted);
      max-width: 640px;
      margin: 0 auto;
      line-height: 1.5;
    }

    .inspector-workspace {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    /* Input Card */
    .input-card {
      background: var(--color-bg-surface);
      border: 1px solid var(--color-border);
      border-radius: 16px;
      padding: 1.25rem 1.5rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    }

    .input-label {
      display: block;
      font-weight: 700;
      font-size: 0.95rem;
      color: var(--color-text-base);
      margin-bottom: 0.6rem;
    }

    .url-input-group {
      display: flex;
      align-items: center;
      background: var(--color-bg-input);
      border: 2px solid var(--color-border);
      border-radius: 12px;
      padding: 0.4rem 0.75rem;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .url-input-group:focus-within {
      border-color: var(--color-accent);
      box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-accent) 15%, transparent);
    }

    .input-prefix-icon {
      display: flex;
      align-items: center;
      color: var(--color-text-muted);
      padding-right: 0.6rem;
    }

    .input-prefix-icon svg {
      width: 20px;
      height: 20px;
    }

    .url-input {
      flex: 1;
      border: none;
      background: transparent;
      outline: none;
      font-size: 1.05rem;
      color: var(--color-text-base);
      font-family: var(--font-mono, monospace);
      width: 100%;
    }

    .input-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .action-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      background: var(--color-bg-surface);
      border: 1px solid var(--color-border);
      border-radius: 8px;
      padding: 0.4rem 0.75rem;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--color-text-base);
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .action-btn:hover {
      background: color-mix(in srgb, var(--color-accent) 10%, transparent);
      border-color: var(--color-accent);
      color: var(--color-accent);
    }

    .action-btn svg {
      width: 14px;
      height: 14px;
    }

    .text-danger {
      color: var(--color-danger, #ef4444);
    }

    .text-danger:hover {
      background: color-mix(in srgb, var(--color-danger) 10%, transparent);
      border-color: var(--color-danger);
      color: var(--color-danger);
    }

    /* Security Dashboard */
    .security-dashboard {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }

    @media (max-width: 900px) {
      .security-dashboard {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 550px) {
      .security-dashboard {
        grid-template-columns: 1fr;
      }
    }

    .security-card {
      background: var(--color-bg-surface);
      border: 1px solid var(--color-border);
      border-radius: 14px;
      padding: 1rem 1.2rem;
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .sec-icon-wrap {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      background: color-mix(in srgb, var(--color-text-muted) 15%, transparent);
      color: var(--color-text-muted);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .sec-icon-wrap svg {
      width: 20px;
      height: 20px;
    }

    .sec-icon-wrap.secure {
      background: #10b98122;
      color: #10b981;
    }

    .sec-icon-wrap.warning {
      background: #f59e0b22;
      color: #f59e0b;
    }

    .sec-icon-wrap.info {
      background: color-mix(in srgb, var(--color-accent) 15%, transparent);
      color: var(--color-accent);
    }

    .sec-info {
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .sec-label {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-muted);
    }

    .sec-status-text {
      font-size: 0.92rem;
      font-weight: 700;
      color: var(--color-text-base);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .action-card {
      justify-content: center;
      padding: 0.75rem;
    }

    .open-btn {
      width: 100%;
      height: 100%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
