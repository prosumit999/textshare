---
interface Props {
  error?: string;
  slug: string;
}

const { error, slug } = Astro.props;
---

<div class="password-gate-card">
  <svg class="icon-svg" viewBox="0 0 24 24" style="width:48px; height:48px; color:var(--color-accent); margin:0 auto var(--space-4);">
    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
  </svg>
  <h2>Password Protected Share</h2>
  <p style="color:var(--color-text-muted); font-size:13px; margin-top:var(--space-2);">
    This link is encrypted. Enter the password below to decrypt and view the content.
  </p>

  <form method="POST" class="password-gate-form">
    <!-- Pass a hidden field to identify password attempt -->
    <input type="hidden" name="action" value="verify_password" />
    
    <div>
      <input 
        type="password" 
        name="sharePassword" 
        class="text-input" 
        placeholder="Enter password" 
        required 
        aria-label="Share password"
        autofocus
      />
      {error && (
        <span style="color:var(--color-danger); font-size:12px; margin-top:var(--space-2); display:block;">
          {error}
        </span>
      )}
    </div>

    <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center;">
      Unlock Share
    </button>
  </form>
</div>
