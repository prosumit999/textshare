---
import { getCurrentUser } from '../lib/auth';
const hasSession = !!(await getCurrentUser(Astro.cookies));
const currentPath = Astro.url.pathname;
---

<nav class="mobile-bottom-nav" aria-label="Mobile quick navigation">
  <a href="/join" class:list={["mobile-nav-item", { active: currentPath === '/join' }]}>
    <svg class="icon-svg" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="9" cy="7" r="4"></circle>
      <path d="M3 21v-2a6 6 0 0 1 12 0v2"></path>
      <line x1="19" y1="8" x2="19" y2="14"></line>
      <line x1="22" y1="11" x2="16" y2="11"></line>
    </svg>
    <span>Join</span>
  </a>

  <a href="/blog" class:list={["mobile-nav-item", { active: currentPath.startsWith('/blog') }]}>
    <svg class="icon-svg" viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="3" width="7" height="7" rx="1"></rect>
      <rect x="14" y="3" width="7" height="7" rx="1"></rect>
      <rect x="3" y="14" width="7" height="7" rx="1"></rect>
      <rect x="14" y="14" width="7" height="7" rx="1"></rect>
    </svg>
    <span>Blog</span>
  </a>

  <a href="/" class:list={["mobile-nav-create", { active: currentPath === '/' }]} aria-label="Create a new share">
    <svg class="icon-svg" viewBox="0 0 24 24" aria-hidden="true">
      <line x1="12" y1="5" x2="12" y2="19"></line>
      <line x1="5" y1="12" x2="19" y2="12"></line>
    </svg>
    <span>Create</span>
  </a>

  <a href={hasSession ? '/profile' : '/login'} class:list={["mobile-nav-item", { active: currentPath === '/login' || currentPath === '/profile' }]}>
    <svg class="icon-svg" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="8" r="4"></circle>
      <path d="M4 21a8 8 0 0 1 16 0"></path>
    </svg>
    <span>{hasSession ? 'Account' : 'Sign in'}</span>
  </a>

  <a href="/pricing" class:list={["mobile-nav-item", "mobile-nav-upgrade", { active: currentPath === '/pricing' }]}>
    <svg class="icon-svg" viewBox="0 0 24 24" aria-hidden="true">
      <path d="m12 3 3 6 6 .9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.9 9 9z"></path>
    </svg>
    <span>Upgrade</span>
  </a>
</nav>
