---
const currentYear = new Date().getFullYear();

const posts = [
  { title: 'Secure text sharing: Best practices', href: '#' },
  { title: 'How to share code without the noise', href: '#' },
  { title: 'Expiring links explained', href: '#' }
];
---

<footer>
  <div class="container">
    <div class="footer-panel">
      <div class="footer-grid">
        <section class="footer-column footer-about" aria-labelledby="footer-brand-title">
          <a href="/" class="footer-brand-mark" id="footer-brand-title" aria-label="TextShare home">
            <svg class="icon-svg" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="9" y1="13" x2="15" y2="13"></line>
              <line x1="9" y1="17" x2="15" y2="17"></line>
            </svg>
            <span>Text<span class="logo-accent">Share</span></span>
          </a>
          <p>Fast, private, and thoughtfully designed sharing for developers. Built to keep your workflow moving.</p>
          <div class="footer-socials" aria-label="Social links">
            <a href="#" aria-label="LinkedIn">in</a>
            <a href="#" aria-label="Instagram">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1"></circle></svg>
            </a>
            <a href="#" aria-label="GitHub">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7A5.4 5.4 0 0 0 19.3 4 5 5 0 0 0 19.2.5S18 0 15 2a13.4 13.4 0 0 0-7 0C5-.1 3.8.5 3.8.5A5 5 0 0 0 3.7 4a5.4 5.4 0 0 0-1.5 3.7c0 5.4 3.5 6.6 6.8 7A4.8 4.8 0 0 0 8 18v4"></path><path d="M8 19c-3 .9-3-1.5-4-2"></path></svg>
            </a>
            <a href="#" aria-label="X">𝕏</a>
          </div>
        </section>

        <section class="footer-column" aria-labelledby="footer-posts-title">
          <h2 id="footer-posts-title">Popular blog posts</h2>
          <nav class="footer-posts" aria-label="Popular blog posts">
            {posts.map((post) => <a href={post.href}>{post.title}</a>)}
          </nav>
        </section>

        <section class="footer-column footer-extension" aria-labelledby="footer-extension-title">
          <h2 id="footer-extension-title">Get the extension</h2>
          <p>Share text from any page in one click, right from Chrome.</p>
          <a href="#" class="extension-badge" aria-label="Get TextShare from the Chrome Web Store">
            <span class="chrome-mark" aria-hidden="true"></span>
            <span><small>Available on the</small><strong>Chrome Web Store</strong></span>
          </a>
        </section>
      </div>

      <div class="footer-bottom">
        <span>&copy; {currentYear} TextShare. All rights reserved.</span>
        <nav class="footer-legal" aria-label="Legal links">
          <a href="#">About</a>
          <a href="#">Privacy</a>
          <a href="#">Terms</a>
          <a href="#">Contact</a>
        </nav>
      </div>
    </div>
  </div>
</footer>
