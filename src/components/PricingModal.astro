<dialog id="pricing-modal" class="pricing-modal" aria-labelledby="pricing-modal-title">
  <div class="pricing-modal-card">
    <button class="pricing-modal-close" type="button" aria-label="Close pricing">×</button>
    <div class="pricing-modal-brand">
      <div class="pricing-modal-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="m12 3 3 6 6 .9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.9 9 9z"></path></svg>
      </div>
      <div><span>TextShare</span><strong>PRO</strong></div>
    </div>
    <div class="pricing-modal-heading">
      <span class="pricing-modal-kicker">One simple upgrade</span>
      <h2 id="pricing-modal-title">More control for everything you share.</h2>
      <p class="pricing-modal-intro">Choose how long links live, protect private content, and share without active-link limits. Burn After First View stays free.</p>
    </div>
    <ul class="pricing-modal-features">
      <li><span>✓</span><div><strong>Flexible expiry</strong><small>Choose 1 week, 1 month, or 1 year</small></div></li>
      <li><span>✓</span><div><strong>Password protection</strong><small>Keep sensitive rooms private</small></div></li>
      <li><span>✓</span><div><strong>Unlimited shares</strong><small>No one-active-link restriction</small></div></li>
      <li><span>✓</span><div><strong>Multi-image rooms</strong><small>Up to 5 images for 24 hours</small></div></li>
      <li><span>✓</span><div><strong>Custom slugs</strong><small>Create memorable six-character links</small></div></li>
    </ul>
    <div class="pricing-billing-label"><span>Choose billing</span><small>Cancel anytime</small></div>
    <div class="pricing-modal-options">
      <button type="button" class="pricing-option" data-plan="monthly" aria-pressed="false">
        <span class="pricing-option-radio"></span><span><strong>Monthly</strong><small>Flexible billing</small></span><b>$3<small>/mo</small></b>
      </button>
      <button type="button" class="pricing-option recommended selected" data-plan="annual" aria-pressed="true">
        <span class="pricing-option-radio"></span><span><em>Save 44%</em><strong>Annual</strong><small>Best value</small></span><b>$20<small>/yr</small></b>
      </button>
    </div>
    <button type="button" class="btn btn-primary pricing-modal-cta premium-hook-btn" data-plan="annual"><span>Continue with annual</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg></button>
    <div class="pricing-modal-assurance"><span><svg viewBox="0 0 24 24"><path d="M7 11V8a5 5 0 0 1 10 0v3"></path><rect x="4" y="11" width="16" height="10" rx="2"></rect></svg>Secure checkout</span><span>No hidden fees</span><span>Burn stays free</span></div>
    <p class="pricing-modal-note" aria-live="polite"></p>
  </div>
</dialog>

<script>
  const modal = document.querySelector<HTMLDialogElement>('#pricing-modal');
  const openPricing = () => {
    if (!modal?.open) modal?.showModal();
  };
  document.querySelectorAll<HTMLAnchorElement>('a[href="/pricing"], [data-pricing-modal]').forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      openPricing();
    });
  });
  document.addEventListener('textshare:pricing', openPricing);
  modal?.querySelector<HTMLButtonElement>('.pricing-modal-close')?.addEventListener('click', () => modal.close());
  modal?.addEventListener('click', (event) => {
    if (event.target === modal) modal.close();
  });
  const planOptions = modal?.querySelectorAll<HTMLButtonElement>('.pricing-option');
  const checkoutButton = modal?.querySelector<HTMLButtonElement>('.pricing-modal-cta');
  planOptions?.forEach((button) => {
    button.addEventListener('click', () => {
      planOptions.forEach((option) => {
        const selected = option === button;
        option.classList.toggle('selected', selected);
        option.setAttribute('aria-pressed', String(selected));
      });
      if (checkoutButton) {
        checkoutButton.dataset.plan = button.dataset.plan;
        const label = checkoutButton.querySelector('span');
        if (label) label.textContent = `Continue with ${button.dataset.plan}`;
      }
    });
  });
  checkoutButton?.addEventListener('click', async () => {
      const note = modal?.querySelector<HTMLElement>('.pricing-modal-note');
      const label = checkoutButton.querySelector('span');
      const plan = checkoutButton.dataset.plan === 'monthly' ? 'monthly' : 'annual';
      checkoutButton.disabled = true;
      if (label) label.textContent = 'Opening secure checkout…';
      if (note) note.textContent = '';
      try {
        const response = await fetch('/api/billing/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ plan }),
        });
        if (response.status === 401) {
          window.location.assign(`/login?next=${encodeURIComponent(`/?pricing=1`)}`);
          return;
        }
        const result = await response.json() as { url?: string; error?: string };
        if (!response.ok || !result.url) throw new Error(result.error || 'Checkout could not be opened.');
        window.location.assign(result.url);
      } catch (error) {
        if (note) note.textContent = error instanceof Error ? error.message : 'Checkout could not be opened.';
        checkoutButton.disabled = false;
        if (label) label.textContent = `Continue with ${plan}`;
      }
  });
  if (new URLSearchParams(window.location.search).has('pricing')) openPricing();
</script>
