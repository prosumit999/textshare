---
import { getCurrentUser } from '../lib/auth';
const hasSession = !!getCurrentUser(Astro.cookies);
---

<div id="mobile-drawer" class="drawer-root" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
  <!-- Backdrop dimmer -->
  <div class="drawer-backdrop"></div>

  <!-- Swipe-dismiss scroller container -->
  <div class="drawer-scroller" id="drawer-scroller">
    <div class="drawer-contents">
      <!-- Offscreen spacer (width: 100vw - 280px) to control snap position -->
      <div class="drawer-spacer"></div>

      <!-- Drawer Sheet (width: 280px) -->
      <div class="drawer-sheet" id="drawer-sheet" tabindex="-1">
        <div class="drawer-header">
          <span id="drawer-title" class="logo" style="font-size: 14px;">
            Text<span class="logo-accent">Share</span>
          </span>
          <button id="drawer-close" class="btn btn-icon" aria-label="Close menu">
            <svg class="icon-svg" viewBox="0 0 24 24">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <nav class="drawer-nav" aria-label="Mobile Navigation">
          <a href="/" class="drawer-nav-link">
            <svg class="icon-svg" viewBox="0 0 24 24">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            Home
          </a>
          <a href="/join" class="drawer-nav-link">
            <svg class="icon-svg" viewBox="0 0 24 24">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <line x1="19" y1="8" x2="19" y2="14"></line>
              <line x1="22" y1="11" x2="16" y2="11"></line>
            </svg>
            Join Room
          </a>
          {hasSession ? (
            <a href="/dashboard" class="drawer-nav-link">
              <svg class="icon-svg" viewBox="0 0 24 24">
                <rect width="7" height="9" x="3" y="3" rx="1"></rect>
                <rect width="7" height="5" x="14" y="3" rx="1"></rect>
                <rect width="7" height="9" x="14" y="12" rx="1"></rect>
                <rect width="7" height="5" x="3" y="15" rx="1"></rect>
              </svg>
              All Shares
            </a>
            <form action="/api/logout" method="POST" style="margin:0;">
              <button type="submit" class="drawer-nav-link" style="background:none; border:none; width:100%; text-align:left; cursor:pointer;">
                <svg class="icon-svg" viewBox="0 0 24 24">
                  <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                  <polyline points="16 17 21 12 16 7"></polyline>
                  <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                Sign Out
              </button>
            </form>
          ) : (
            <>
              <a href="/dashboard" class="drawer-nav-link">
                <svg class="icon-svg" viewBox="0 0 24 24">
                  <rect width="7" height="9" x="3" y="3" rx="1"></rect>
                  <rect width="7" height="5" x="14" y="3" rx="1"></rect>
                  <rect width="7" height="9" x="14" y="12" rx="1"></rect>
                  <rect width="7" height="5" x="3" y="15" rx="1"></rect>
                </svg>
                All Shares
              </a>
              <a href="/login" class="drawer-nav-link">
                <svg class="icon-svg" viewBox="0 0 24 24">
                  <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                  <polyline points="10 17 15 12 10 7"></polyline>
                  <line x1="15" y1="12" x2="3" y2="12"></line>
                </svg>
                Sign In
              </a>
            </>
          )}
          <a href="/pricing" class="drawer-nav-link" style="color:var(--color-accent);">
            <svg class="icon-svg" viewBox="0 0 24 24" stroke="currentColor">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
            </svg>
            Go Pro (Premium)
          </a>
        </nav>

        <div class="drawer-footer">
          <p>TextShare Mobile Menu</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const drawer = document.getElementById("mobile-drawer");
  const sheet = document.getElementById("drawer-sheet");
  const openBtn = document.getElementById("hamburger-menu");
  const closeBtn = document.getElementById("drawer-close");
  const backdrop = drawer?.querySelector(".drawer-backdrop") as HTMLElement;

  if (drawer && sheet && openBtn && closeBtn && backdrop) {
    function openDrawer() {
      drawer.classList.add("open");
      document.body.classList.add("drawer-open");
      openBtn.setAttribute("aria-expanded", "true");
      window.setTimeout(() => sheet.focus(), 50);
    }

    function closeDrawer() {
      if (!drawer.classList.contains("open")) return;
      drawer.classList.remove("open");
      document.body.classList.remove("drawer-open");
      openBtn.setAttribute("aria-expanded", "false");
      openBtn.focus();
    }

    openBtn.addEventListener("click", openDrawer);
    closeBtn.addEventListener("click", closeDrawer);
    backdrop.addEventListener("click", closeDrawer);

    drawer.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeDrawer);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeDrawer();
      }
    });
  }
</script>
