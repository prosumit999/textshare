{
  "manifest_version": 3,
  "name": "Text Share – Quick Text Sharing",
  "description": "Send selected text or a quick note to Text Share.",
  "version": "1.0.0",
  "permissions": ["contextMenus"],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Share with Text Share – Quick Text Sharing",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    },
    "default_popup": "popup.html"
  }
}
